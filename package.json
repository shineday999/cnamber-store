{
  "name": "cnamber-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "森林系手作品牌電商——琥珀飾品與香品,大東南亞+中東市場,六語在地化",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "wrangler pages deploy ./dist --project-name=cnamber-store --branch=main --commit-dirty=true",
    "check": "astro check",
    "test": "vitest run",
    "lint": "eslint --ext .ts,.tsx,.astro src/"
  },
  "dependencies": {
    "astro": "^4.16.0",
    "@astrojs/react": "^3.6.0",
    "@astrojs/tailwind": "^5.1.0",
    "@astrojs/node": "^8.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "style-dictionary": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "eslint-plugin-astro": "^1.3.0",
    "prettier": "^3.3.0",
    "prettier-plugin-astro": "^0.14.0",
    "wrangler": "^3.0.0"
  }
