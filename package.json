{
  "name": "cnamber-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "\u68ee\u6797\u7cfb\u624b\u4f5c\u54c1\u724c\u96fb\u5546\u2014\u2014\u7425\u73c0\u98fe\u54c1\u8207\u9999\u54c1,\u5927\u6771\u5357\u4e9e+\u4e2d\u6771\u5e02\u5834,\u516d\u8a9e\u5728\u5730\u5316",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro",
    "astro": "astro",
    "deploy": "wrangler pages deploy ./dist --project-name=cnamber-store --branch=main --commit-dirty=true",
    "check": "astro check",
    "test": "vitest run",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "format": "prettier --write \"**/*.{ts,tsx,astro,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,astro,json,md,yml}\"",
    "prepare": "husky",
    "postbuild": "node scripts/postbuild-fix-assets-binding.cjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^7.0.0",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^7.3.5",
    "autoprefixer": "^10.4.0",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.10",
    "jose": "^6.2.12",
    "postcss": "^8.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "style-dictionary": "^4.0.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.3",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/ui": "^2.1.9",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "nodemailer": "^10.0.13",
    "prettier": "^3.3.0",
    "prettier-plugin-astro": "^0.14.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.147.0"
  },
  "lint-staged": {
    "*.{ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "allowBuilds": {
      "@bundled-es-modules/glob": true,
      "esbuild": true,
      "sharp": true,
      "style-dictionary": true,
      "workerd": true
    }
  }
}
