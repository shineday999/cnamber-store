{
  "name": "cnamber-store",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cnamber-store",
      "database_id": "adbf8443-b2ab-4042-9781-d36588a8f5b8",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "cnamber-store-images",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "I18N",
      "id": "4c8f1d2d42c040a9958d3c133426d896",
    },
    {
      "binding": "SESSION",
      "id": "17d4d35864084de1a9ee85c46505ec7e",
    },
  ],
  "vars": {
    "EMAIL_FROM": "OxHorseCraft <oxsupport@0061qwen.cc.cd>",
    "EMAIL_REPLY_TO": "oxsupport@0061qwen.cc.cd",
  },
}
