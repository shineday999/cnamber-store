---
// Layout — 全站共用 layout (2026-10-01: Awwwards-tier header with main nav)
import "../styles/global.css";
import LocaleSwitcher from "@components/LocaleSwitcher.astro";
import Footer from "@components/Footer.astro";
import { createT } from "../i18n/t";
import {
  defaultLocale,
  locales,
  localeHreflang,
  type Locale,
  localizedPath,
} from "../i18n/config";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = "", ogImage = "/og-image.svg" } = Astro.props;
const currentLocale = (Astro.locals.locale ?? defaultLocale) as Locale;
const siteUrl = Astro.url.origin || "https://cnamber.ccwu.cc";
const cleanPath =
  currentLocale === defaultLocale
    ? Astro.url.pathname
    : Astro.url.pathname.replace(new RegExp(`^/${currentLocale}`), "") || "/";

// Hero style overrides from site_settings (admin-editable via /admin/settings → Hero Style).
// F-04: regex allowlist 拒絕任何含 } { ; /* @ 等 CSS 注入 meta chars 的值
// F-17: try/catch 包 D1 query,缺表 fallback 不 crash render
const SAFE_COLOR =
  /^(#[0-9a-fA-F]{3,8}|rgba?\(\s*[\d\s,.]+\s*\)|[a-zA-Z]{3,30})$/;
const SAFE_LENGTH = /^\d+(\.\d+)?(px|rem|em|%|vh|vw)$/;
function sanitizeStyle(key: string, raw: string, fallback: string): string {
  if (!raw) return fallback;
  if (key.endsWith("_color")) return SAFE_COLOR.test(raw) ? raw : fallback;
  if (key.endsWith("_size")) return SAFE_LENGTH.test(raw) ? raw : fallback;
  return fallback;
}
const env = Astro.locals.runtime?.env;
async function getStyleVal(key: string, fallback: string): Promise<string> {
  if (!env?.DB) return fallback;
  try {
    const row = await env.DB.prepare(
      "SELECT value FROM site_settings WHERE key = ? AND locale = 'all' LIMIT 1",
    )
      .bind(key)
      .first<{ value: string }>();
    return row?.value?.trim() || fallback;
  } catch (e) {
    console.warn(
      `[Layout] getStyleVal(${key}) failed, using fallback:`,
      e instanceof Error ? e.message : e,
    );
    return fallback;
  }
}
const heroTitleSize = sanitizeStyle(
  "hero_title_size",
  await getStyleVal("hero_title_size", "72px"),
  "72px",
);
const heroSubtitleSize = sanitizeStyle(
  "hero_subtitle_size",
  await getStyleVal("hero_subtitle_size", "24px"),
  "24px",
);
const heroTitleColor = sanitizeStyle(
  "hero_title_color",
  await getStyleVal("hero_title_color", "#FAF7EE"),
  "#FAF7EE",
);
const heroSubtitleColor = sanitizeStyle(
  "hero_subtitle_color",
  await getStyleVal("hero_subtitle_color", "rgba(250, 247, 238, 0.8)"),
  "rgba(250, 247, 238, 0.8)",
);

const hreflangUrls = locales.map((l) => ({
  lang: localeHreflang[l],
  href: `${siteUrl}${localizedPath(l, cleanPath)}`,
}));

const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);
const homePath = localizedPath(currentLocale, "/");
const siteName = t("common.site_name");

// Main nav (locale-aware)
const nav = [
  { label: t("nav.products"), href: localizedPath(currentLocale, "/products") },
  { label: t("nav.story"), href: localizedPath(currentLocale, "/story") },
  { label: t("nav.quiz"), href: localizedPath(currentLocale, "/quiz") },
  { label: t("nav.contact"), href: localizedPath(currentLocale, "/contact") },
];
---

<!doctype html>
<html
  lang={currentLocale}
  style={`--hero-title-size:${heroTitleSize};--hero-subtitle-size:${heroSubtitleSize};--hero-title-color:${heroTitleColor};--hero-subtitle-color:${heroSubtitleColor};`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    {
      hreflangUrls.map(({ lang, href }) => (
        <link rel="alternate" hreflang={lang} href={href} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={`${siteUrl}${localizedPath(defaultLocale, cleanPath)}`}
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:url" content={`${siteUrl}${Astro.url.pathname}`} />
    <meta
      property="og:locale"
      content={localeHreflang[currentLocale].replace("-", "_")}
    />
    {
      locales
        .filter((l) => l !== currentLocale)
        .map((l) => (
          <meta
            property="og:locale:alternate"
            content={localeHreflang[l].replace("-", "_")}
          />
        ))
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,700;1,400;1,500&family=Noto+Serif+SC:wght@300;400;500;700&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
  </head>
  <body class="bg-white text-text-primary">
    <header class="sticky top-0 z-40 w-full glass border-b border-forest-900/5">
      <div
        class="max-w-6xl mx-auto px-6 py-3 flex items-center justify-between gap-4"
      >
        <a
          href={homePath}
          aria-label={`${siteName} — home`}
          class="flex items-center gap-2.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40 rounded-md shrink-0"
        >
          <svg
            viewBox="0 0 32 32"
            class="w-8 h-8 text-terra-500 transition-transform group-hover:scale-105"
            aria-hidden="true"
          >
            <path
              d="M16 3 C 9 12, 5 19, 10 25 C 13 29, 19 29, 22 25 C 27 19, 23 12, 16 3 Z"
              fill="currentColor"></path>
            <path
              d="M12 21 Q 16 17 20 21"
              stroke="rgba(250,247,238,0.7)"
              stroke-width="1.2"
              fill="none"
              stroke-linecap="round"></path>
          </svg>
          <span
            class="font-serif text-lg font-light text-forest-800 tracking-wide group-hover:text-forest-600 transition-colors"
          >
            {siteName}
          </span>
        </a>

        <nav
          class="hidden md:flex items-center gap-7 text-sm font-sans"
          aria-label="Main"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="text-text-secondary hover:text-forest-700 transition-colors duration-300 link-underline"
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="flex items-center gap-3 shrink-0">
          <button
            type="button"
            class="md:hidden p-2 -mr-2 text-forest-800 hover:opacity-70 transition-opacity focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40 rounded"
            aria-label="Open menu"
            aria-controls="mobile-menu"
            aria-expanded="false"
            data-mobile-menu-trigger
          >
            <svg
              class="w-6 h-6"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <line x1="4" y1="8" x2="20" y2="8"></line>
              <line x1="4" y1="16" x2="20" y2="16"></line>
            </svg>
          </button>
          <LocaleSwitcher />
        </div>
      </div>
    </header>

    <!-- Mobile menu overlay (md:hidden, fixed full-screen) -->
    <div
      id="mobile-menu"
      class="fixed inset-0 z-50 bg-forest-900 text-bg-base md:hidden flex flex-col opacity-0 pointer-events-none transition-opacity duration-500 ease-out"
      data-mobile-menu
      aria-hidden="true"
      aria-modal="true"
      role="dialog"
      aria-label="Main menu"
    >
      <div
        class="flex items-center justify-between p-6 border-b border-forest-700/40"
      >
        <span class="font-serif text-lg font-light tracking-wide text-bg-base">
          {siteName}
        </span>
        <button
          type="button"
          class="p-2 -mr-2 text-bg-base hover:opacity-70 transition-opacity focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-300/40 rounded"
          aria-label="Close menu"
          data-mobile-menu-close
        >
          <svg
            class="w-6 h-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="6" y1="6" x2="18" y2="18"></line>
            <line x1="18" y1="6" x2="6" y2="18"></line>
          </svg>
        </button>
      </div>

      <nav
        class="flex-1 flex flex-col items-center justify-center px-8 gap-8"
        aria-label="Mobile"
      >
        {
          nav.map((item) => (
            <a
              href={item.href}
              class="font-serif text-4xl text-bg-base hover:opacity-70 transition-opacity duration-300"
              data-mobile-menu-link
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="p-6 flex justify-center border-t border-forest-700/40">
        <LocaleSwitcher />
      </div>
    </div>

    <slot />
    <Footer />

    <script>
      (function () {
        const trigger = document.querySelector("[data-mobile-menu-trigger]");
        const menu = document.querySelector("[data-mobile-menu]");
        if (!trigger || !menu) return;

        const closeBtn = menu.querySelector("[data-mobile-menu-close]");
        const links = menu.querySelectorAll("[data-mobile-menu-link]");

        const open = () => {
          menu.dataset.open = "true";
          menu.setAttribute("aria-hidden", "false");
          trigger.setAttribute("aria-expanded", "true");
          document.body.style.overflow = "hidden";
          requestAnimationFrame(() => closeBtn?.focus());
        };
        const close = () => {
          delete menu.dataset.open;
          menu.setAttribute("aria-hidden", "true");
          trigger.setAttribute("aria-expanded", "false");
          document.body.style.overflow = "";
          trigger.focus();
        };

        trigger.addEventListener("click", open);
        closeBtn?.addEventListener("click", close);
        links.forEach((link) => link.addEventListener("click", close));
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && menu.dataset.open === "true") close();
        });
      })();
    </script>

    <style>
      [data-mobile-menu][data-open="true"] {
        opacity: 1;
        pointer-events: auto;
      }
      @media (prefers-reduced-motion: reduce) {
        [data-mobile-menu] {
          transition: none;
        }
      }
    </style>
  </body>
</html>
