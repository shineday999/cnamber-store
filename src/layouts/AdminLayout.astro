---
// AdminLayout — 後台共用 layout
// 認證已由 middleware 處理(session JWT cookie,2026-10-01 取代 Cloudflare Access)
// Wave 16: 加入 global.css import(補 :root CSS vars)+ t() i18n 整合
import "../styles/global.css";
import { createT } from "../i18n/t";
import { defaultLocale, type Locale } from "../i18n/config";
import zhHansMessages from "../i18n/messages/zh-Hans.json";

interface Props {
  title: string;
  active?: "dashboard" | "products" | "orders" | "reviews" | "blog";
}

const { title, active = "dashboard" } = Astro.props;
const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = zhHansMessages as Record<string, unknown>;
const t = createT(messages);
const admin = Astro.locals.admin;

const navItems = [
  { key: "dashboard", label: t("admin.nav.dashboard"), href: "/admin" },
  { key: "products", label: t("admin.nav.products"), href: "/admin/products" },
  { key: "orders", label: t("admin.nav.orders"), href: "/admin/orders" },
  { key: "blog", label: t("admin.nav.blog"), href: "/admin/posts" },
  { key: "reviews", label: t("admin.nav.reviews"), href: "/admin/reviews" },
] as const;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · cnamber-store admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-bg-base font-sans text-text-primary">
    <header class="bg-forest-900 text-bg-base shadow-md">
      <div
        class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between"
      >
        <div class="flex items-center gap-3">
          <span class="font-serif text-xl">cnamber-store</span>
          <span class="text-xs uppercase tracking-wider text-accent-300"
            >{t("admin.common.admin_badge")}</span
          >
        </div>
        <div class="flex items-center gap-4 text-sm">
          <span class="text-bg-base/70">{admin?.email}</span>
          <span class="px-2 py-0.5 rounded bg-accent-700 text-bg-base text-xs"
            >{admin?.role}</span
          >
          <a href="/" class="text-bg-base/70 hover:text-bg-base"
            >{t("admin.common.view_site")}</a
          >
          <form method="POST" action="/api/admin/logout" class="inline">
            <button
              type="submit"
              class="text-bg-base/70 hover:text-bg-base text-sm hover:underline underline-offset-2"
            >
              {t("admin.common.signout")}
            </button>
          </form>
        </div>
      </div>
      <nav class="bg-forest-700">
        <ul class="max-w-7xl mx-auto px-6 flex gap-1">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class={`block px-4 py-3 text-sm font-medium transition-colors ${
                    active === item.key
                      ? "bg-bg-base text-forest-900 border-b-2 border-accent-500"
                      : "text-bg-base/80 hover:bg-forest-500 hover:text-bg-base"
                  }`}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main class="max-w-7xl mx-auto px-6 py-8">
      <h1 class="text-display-sm font-serif mb-6">{title}</h1>
      <slot />
    </main>

    <footer
      class="max-w-7xl mx-auto px-6 py-6 text-xs text-text-muted border-t border-text-muted/20"
    >
      {t("admin.footer.tagline")}
    </footer>
  </body>
</html>
