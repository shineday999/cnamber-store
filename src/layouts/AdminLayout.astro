---
// AdminLayout — 後台共用 layout
// 認證已由 middleware 處理(session JWT cookie,2026-10-01 取代 Cloudflare Access)
// Wave 16: 加入 global.css import(補 :root CSS vars)+ t() i18n 整合
// 2026-10-05: 右上角加「改密碼」trigger button + mount ChangePasswordModal
import "../styles/global.css";
import { createT } from "../i18n/t";
import { defaultLocale, type Locale } from "../i18n/config";
import zhHansMessages from "../i18n/messages/zh-Hans.json";
import ChangePasswordModal from "../components/admin/ChangePasswordModal.astro";

interface Props {
  title: string;
  active?:
    | "dashboard"
    | "products"
    | "orders"
    | "reviews"
    | "blog"
    | "banners"
    | "settings";
}

const { title, active = "dashboard" } = Astro.props;
const pwError = Astro.url.searchParams.get("pw_error");
const pwSaved = Astro.url.searchParams.get("password_changed") === "1";
const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = zhHansMessages as Record<string, unknown>;
const t = createT(messages);
const admin = Astro.locals.admin;

// Wave 28.8f: 網站標題跟著 siteSettings.siteName 變動(fallback: locale → zh-Hans → en → "cnamber-store")
const siteName: string =
  Astro.locals.siteSettings?.siteName[locale] ??
  Astro.locals.siteSettings?.siteName["zh-Hans"] ??
  Astro.locals.siteSettings?.siteName["en"] ??
  "cnamber-store";

const navItems = [
  { key: "dashboard", label: t("admin.nav.dashboard"), href: "/admin" },
  { key: "products", label: t("admin.nav.products"), href: "/admin/products" },
  { key: "orders", label: t("admin.nav.orders"), href: "/admin/orders" },
  { key: "blog", label: t("admin.nav.blog"), href: "/admin/posts" },
  { key: "reviews", label: t("admin.nav.reviews"), href: "/admin/reviews" },
  { key: "settings", label: t("admin.nav.settings"), href: "/admin/settings" },
] as const;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · {siteName} admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-cream-50 font-sans text-text-primary">
    <div
      class="h-[3px] w-full bg-gradient-to-r from-accent-700 via-accent-500 to-accent-300"
      aria-hidden="true"
    >
    </div>
    <header class="bg-forest-900 text-bg-base shadow-md">
      <div
        class="max-w-7xl mx-auto px-4 sm:px-6 py-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-2"
      >
        <div class="flex items-center gap-3">
          <span class="font-serif text-xl">{siteName}</span>
          <span
            class="text-[0.7rem] uppercase tracking-[0.15em] text-accent-300"
            >{t("admin.common.admin_badge")}</span
          >
        </div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
          <span class="hidden sm:inline text-bg-base/70">{admin?.email}</span>
          <span class="px-2 py-0.5 rounded bg-accent-700 text-bg-base text-xs"
            >{admin?.role}</span
          >
          <button
            type="button"
            class="text-bg-base/70 hover:text-bg-base text-sm hover:underline underline-offset-2"
            data-change-password-trigger
            aria-haspopup="dialog"
          >
            {t("admin.change_password.trigger_label")}
          </button>
          <a href="/" class="text-bg-base/70 hover:text-bg-base"
            >{t("admin.common.view_site")}</a
          >
          <form method="POST" action="/api/admin/logout" class="inline">
            <button
              type="submit"
              class="text-bg-base/70 hover:text-bg-base text-sm hover:underline underline-offset-2"
            >
              {t("admin.common.signout")}
            </button>
          </form>
        </div>
      </div>
      <nav class="bg-forest-700">
        <ul
          class="max-w-7xl mx-auto px-4 sm:px-6 flex gap-1 overflow-x-auto flex-nowrap"
        >
          {
            navItems.map((item) => (
              <li class="shrink-0">
                <a
                  href={item.href}
                  class={`block whitespace-nowrap px-4 py-3 text-sm font-medium transition-colors border-b-2 ${
                    active === item.key
                      ? "text-bg-base border-accent-500"
                      : "text-bg-base/70 border-transparent hover:text-bg-base"
                  }`}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 py-8 sm:py-10">
      <h1 class="text-3xl font-serif mb-6">{title}</h1>
      <slot />
    </main>

    <ChangePasswordModal
      currentPath={Astro.url.pathname}
      error={pwError}
      saved={pwSaved}
    />

    <footer
      class="max-w-7xl mx-auto px-4 sm:px-6 py-6 text-xs text-text-muted border-t border-text-muted/20"
    >
      {t("admin.footer.tagline", { siteName })}
    </footer>
  </body>
</html>
