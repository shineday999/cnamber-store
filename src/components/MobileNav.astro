---
// 手機版專用導覽 (<768px 才顯示，桌面版 CSS 會隱藏)
const path = Astro.url.pathname;
const m = path.match(/^\/(en|ms-MY|id-ID)(?=\/|$)/);
const lang = (m ? m[1] : "zh") as "zh" | "en" | "ms-MY" | "id-ID";
const prefix = m ? `/${m[1]}` : "";
const rest = m ? path.slice(m[0].length) || "/" : path;

const labels = {
  zh: {
    home: "首页",
    products: "产品",
    quiz: "选一件",
    cart: "购物车",
    story: "故事",
  },
  en: {
    home: "Home",
    products: "Shop",
    quiz: "Quiz",
    cart: "Cart",
    story: "Story",
  },
  "ms-MY": {
    home: "Utama",
    products: "Produk",
    quiz: "Kuiz",
    cart: "Troli",
    story: "Kisah",
  },
  "id-ID": {
    home: "Beranda",
    products: "Produk",
    quiz: "Kuis",
    cart: "Keranjang",
    story: "Kisah",
  },
}[lang];

const tabs = [
  { key: "home", href: prefix || "/", active: rest === "/" },
  { key: "products", href: "/products", active: rest.startsWith("/products") },
  { key: "quiz", href: "/quiz", active: rest.startsWith("/quiz") },
  {
    key: "cart",
    href: "/cart",
    active: rest.startsWith("/cart") || rest.startsWith("/checkout"),
  },
  {
    key: "story",
    href: "/story",
    active: [
      "/story",
      "/vision",
      "/craft",
      "/materials",
      "/about",
      "/blog",
    ].some((p) => rest.startsWith(p)),
  },
] as const;

const icons: Record<string, string> = {
  home: '<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
  products:
    '<rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/>',
  quiz: '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 17l.7 1.8L21.5 19.5l-1.8.7L19 22l-.7-1.8-1.8-.7 1.8-.7z"/>',
  cart: '<path d="M6 7h12l-1 13H7z"/><path d="M9 7a3 3 0 0 1 6 0"/>',
  story:
    '<path d="M5 19c0-8 5-14 15-14 0 10-6 15-14 15"/><path d="M5 19c3-5 6-8 10-10"/>',
};

const langs = [
  { code: "zh", label: "简体中文", href: "/" },
  { code: "en", label: "English", href: "/en/" },
  { code: "ms-MY", label: "Bahasa Melayu", href: "/ms-MY/" },
  { code: "id-ID", label: "Bahasa Indonesia", href: "/id-ID/" },
];
---

<header class="m-header" role="banner">
  <a class="m-brand" href={prefix || "/"} aria-label="牛马得饰">
    <svg
      viewBox="0 0 24 24"
      width="26"
      height="26"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={icons.story}
    />
    <span class="m-brand-text">牛马得饰</span>
  </a>
  <details class="m-lang">
    <summary aria-label="Language">
      <svg
        viewBox="0 0 24 24"
        width="22"
        height="22"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
        ><circle cx="12" cy="12" r="9"></circle><path
          d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"></path></svg
      >
    </summary>
    <ul>
      {
        langs.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={l.code === lang ? "true" : undefined}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </details>
</header>

<nav class="m-tabbar" aria-label="Primary">
  {
    tabs.map((t) => (
      <a
        href={t.href}
        class:list={["m-tab", { "is-active": t.active }]}
        aria-current={t.active ? "page" : undefined}
      >
        <svg
          viewBox="0 0 24 24"
          width="24"
          height="24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          set:html={icons[t.key]}
        />
        <span>{labels[t.key]}</span>
      </a>
    ))
  }
</nav>
