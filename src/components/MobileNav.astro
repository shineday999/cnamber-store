---
// 手機版專用導覽 (<768px 才顯示；桌面版 CSS 會隱藏)
// 語言完全沿用站台機制：Astro.locals.locale / createT / localizedPath
import {
  defaultLocale,
  localeFromPath,
  localeNames,
  localizedPath,
  locales,
  type Locale,
} from "../i18n/config";
import { createT } from "../i18n/t";

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const t = createT(Astro.locals.messages ?? {});

const pathname = Astro.url.pathname;
const pathLocale = localeFromPath(pathname);
const cleanPath = pathLocale
  ? pathname.slice(pathLocale.length + 1) || "/"
  : pathname;

const siteName =
  Astro.locals.siteSettings?.siteName?.[locale] ?? t("common.site_name");
const p = (path: string) => localizedPath(locale, path);

const tabs = [
  {
    key: "home",
    label: t("nav.home"),
    href: p("/"),
    active: cleanPath === "/",
  },
  {
    key: "products",
    label: t("nav.products"),
    href: p("/products"),
    active: cleanPath.startsWith("/products"),
  },
  {
    key: "quiz",
    label: t("nav.quiz"),
    href: p("/quiz"),
    active: cleanPath.startsWith("/quiz"),
  },
  {
    key: "cart",
    label: t("nav.cart"),
    href: p("/cart"),
    active: cleanPath.startsWith("/cart") || cleanPath.startsWith("/checkout"),
  },
  {
    key: "story",
    label: t("nav.story"),
    href: p("/story"),
    active: [
      "/story",
      "/vision",
      "/craft",
      "/materials",
      "/about",
      "/blog",
      "/more",
    ].some((x) => cleanPath.startsWith(x)),
  },
];

const icons: Record<string, string> = {
  home: '<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
  products:
    '<rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/>',
  quiz: '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 17l.7 1.8L21.5 19.5l-1.8.7L19 22l-.7-1.8-1.8-.7 1.8-.7z"/>',
  cart: '<path d="M6 7h12l-1 13H7z"/><path d="M9 7a3 3 0 0 1 6 0"/>',
  story:
    '<path d="M5 19c0-8 5-14 15-14 0 10-6 15-14 15"/><path d="M5 19c3-5 6-8 10-10"/>',
};
---

<header class="m-header" role="banner">
  <a class="m-brand" href={p("/")} aria-label={siteName}>
    <svg
      viewBox="0 0 24 24"
      width="26"
      height="26"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={icons.story}
    />
    <span class="m-brand-text">{siteName}</span>
  </a>
  <details class="m-lang">
    <summary aria-label={t("common.language")}>
      <svg
        viewBox="0 0 24 24"
        width="22"
        height="22"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"></path>
      </svg>
    </summary>
    <ul>
      {
        locales.map((l) => (
          <li>
            <a
              href={localizedPath(l, cleanPath)}
              hreflang={l}
              data-locale={l}
              aria-current={l === locale ? "true" : undefined}
            >
              {localeNames[l]}
            </a>
          </li>
        ))
      }
    </ul>
  </details>
</header>

<nav class="m-tabbar" aria-label="Primary">
  {
    tabs.map((tab) => (
      <a
        href={tab.href}
        class:list={["m-tab", { "is-active": tab.active }]}
        aria-current={tab.active ? "page" : undefined}
      >
        <svg
          viewBox="0 0 24 24"
          width="24"
          height="24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          set:html={icons[tab.key]}
        />
        <span>{tab.label}</span>
      </a>
    ))
  }
</nav>

<script>
  // 點語言連結時寫入 cnamber_locale，否則回到「簡體中文（無前綴）」時 middleware 會讀到舊 cookie
  document.addEventListener("click", (e) => {
    const a = (e.target as HTMLElement | null)?.closest<HTMLAnchorElement>(
      "a[data-locale]",
    );
    if (!a) return;
    const secure = location.protocol === "https:" ? "; secure" : "";
    document.cookie = `cnamber_locale=${a.dataset.locale}; path=/; max-age=2592000; samesite=lax${secure}`;
  });
</script>
