---
// ProductCard — 前台商品卡片
interface Props {
  slug: string;
  name: string;
  shortDescription?: string | undefined;
  category: string;
  imageUrl?: string | undefined;
  priceFrom?: string | undefined;
}

const { slug, name, shortDescription, category, imageUrl, priceFrom } = Astro.props;
const catLabel: Record<string, string> = {
  jewelry: 'Jewelry',
  incense: 'Incense',
};
---

<a
  href={`/products/${slug}`}
  class="group block bg-bg-card border border-text-muted/20 rounded-card overflow-hidden hover:border-accent-500 transition-all hover:shadow-natural-lg"
>
  <div class="aspect-square bg-primary-100 flex items-center justify-center overflow-hidden">
    {imageUrl ? (
      <img
        src={imageUrl}
        alt={name}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    ) : (
      <svg viewBox="0 0 200 200" class="w-32 h-32 text-primary-300" fill="currentColor">
        <circle cx="100" cy="100" r="60" opacity="0.3" />
        <circle cx="100" cy="100" r="40" opacity="0.5" />
        <circle cx="100" cy="100" r="20" opacity="0.7" />
      </svg>
    )}
  </div>
  <div class="p-4">
    <div class="text-xs uppercase tracking-wider text-accent-700 mb-1">
      {catLabel[category] ?? category}
    </div>
    <h3 class="font-serif text-lg leading-tight mb-1 text-text-primary group-hover:text-accent-700 transition-colors">
      {name}
    </h3>
    {shortDescription && (
      <p class="text-sm text-text-secondary line-clamp-2 mb-3">{shortDescription}</p>
    )}
    {priceFrom && (
      <div class="text-sm font-mono text-text-primary">
        from <span class="text-accent-700">{priceFrom}</span>
      </div>
    )}
  </div>
</a>