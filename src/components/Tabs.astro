---
// Tabs — 用於後台切換(core / translations / variants / meta)
// Astro 不支援動態 slot 名稱 <slot name={dynamic} />,改用 hardcoded 4 slots
// 新增 tab 類型時,需在此擴充
interface Tab {
  id: 'core' | 'translations' | 'variants' | 'meta' | string;
  label: string;
}
interface Props {
  tabs: Tab[];
  paramName?: string;
}

const { tabs, paramName = 'tab' } = Astro.props;
const url = Astro.url;
const activeTab = url.searchParams.get(paramName) ?? tabs[0]?.id ?? '';
---

<div class="border-b border-text-muted/20 mb-6">
  <nav class="flex gap-1">
    {tabs.map((tab) => {
      const isActive = tab.id === activeTab;
      const next = new URL(url);
      next.searchParams.set(paramName, tab.id);
      return (
        <a
          href={next.pathname + next.search}
          class={`px-4 py-2 text-sm font-medium border-b-2 transition-colors ${
            isActive
              ? 'border-accent-700 text-accent-700'
              : 'border-transparent text-text-muted hover:text-text-primary'
          }`}
        >
          {tab.label}
        </a>
      );
    })}
  </nav>
</div>

<div data-active-tab={activeTab}>
  <div hidden={activeTab !== 'core'}><slot name="core" /></div>
  <div hidden={activeTab !== 'translations'}><slot name="translations" /></div>
  <div hidden={activeTab !== 'variants'}><slot name="variants" /></div>
  <div hidden={activeTab !== 'meta'}><slot name="meta" /></div>
</div>