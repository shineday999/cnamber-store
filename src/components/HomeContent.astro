---
import Leaf from './Leaf.astro';
import ProductCard from './ProductCard.astro';
import { createT } from '../i18n/t';
import { defaultLocale, type Locale } from '../i18n/config';

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);
void locale;

const env = Astro.locals.runtime?.env;

interface FeaturedProduct {
  id: string;
  slug: string;
  category: string;
  name: string | null;
  short_description: string | null;
  min_price: number | null;
  min_currency: string | null;
  image_urls: string | null;
}

const featured = env?.DB
  ? await env.DB
      .prepare(
        `SELECT p.id, p.slug, p.category,
                pt.name, pt.short_description,
                MIN(pp.amount) AS min_price, pp.currency AS min_currency,
                (SELECT pv.image_urls FROM product_variants pv WHERE pv.product_id = p.id LIMIT 1) AS image_urls
         FROM products p
         LEFT JOIN product_translations pt ON pt.product_id = p.id AND pt.locale = ?
         LEFT JOIN product_variants pv ON pv.product_id = p.id
         LEFT JOIN product_prices pp ON pp.variant_id = pv.id
         WHERE p.status = 'active'
         GROUP BY p.id
         ORDER BY p.created_at DESC LIMIT 4`,
      )
      .bind(locale)
      .all<FeaturedProduct>()
  : { results: [] as FeaturedProduct[] };

function firstImage(json: string | null | undefined): string | undefined {
  if (!json) return undefined;
  try {
    const urls = JSON.parse(json) as string[];
    return Array.isArray(urls) && urls.length > 0 ? urls[0] : undefined;
  } catch {
    return undefined;
  }
}
---

<!-- 1. Hero — dark forest background + decorative Leaf + brand message -->
<section class="relative min-h-[75vh] flex items-center justify-center overflow-hidden bg-gradient-to-br from-primary-900 via-primary-700 to-primary-900 text-bg-base">
  <!-- Decorative Leaf (small, top-right corner, low opacity) -->
  <div class="absolute -top-10 -right-20 w-[500px] h-[500px] opacity-15 pointer-events-none">
    <Leaf />
  </div>
  <div class="absolute -bottom-20 -left-20 w-[400px] h-[400px] opacity-10 pointer-events-none rotate-180">
    <Leaf />
  </div>

  <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
    <p class="text-xs uppercase tracking-[0.3em] text-accent-300 mb-4 font-sans">
      {t('home.hero_kicker')}
    </p>

    <h1 class="text-3xl md:text-5xl lg:text-6xl text-white drop-shadow-lg font-serif mb-4 leading-tight">
      {t('home.hero_title')}
    </h1>

    <p class="text-lg md:text-xl text-accent-300 font-serif italic mb-8">
      {t('home.hero_subtitle')}
    </p>

    <div class="max-w-2xl mx-auto text-bg-base/80 text-base leading-relaxed font-sans space-y-2 mb-8">
      <p>{t('home.hero_p1')}</p>
      <p>{t('home.hero_p2')}</p>
      <p>{t('home.hero_p3')}</p>
    </div>

    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/products" class="px-7 py-2.5 bg-accent-500 text-primary-900 font-medium rounded-md hover:bg-accent-300 transition-colors">
        {t('home.hero_cta_shop')}
      </a>
      <a href="/quiz" class="px-7 py-2.5 border border-bg-base/40 text-bg-base font-medium rounded-md hover:bg-bg-base hover:text-primary-900 transition-colors">
        {t('home.hero_cta_quiz')}
      </a>
    </div>
  </div>
</section>

<!-- 2. Categories — 兩個大型 category cards -->
<section class="py-10 bg-bg-base">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-6">
      <p class="text-xs uppercase tracking-[0.3em] text-accent-700 font-sans mb-2">
        {t('home.categories_kicker')}
      </p>
      <h2 class="text-2xl md:text-3xl font-serif text-text-primary">
        {t('home.categories_title')}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <a href="/products?cat=jewelry" class="group relative aspect-[4/3] rounded-card overflow-hidden bg-primary-100">
        <img
          src="https://picsum.photos/seed/category-amber-jewelry/1200/900"
          alt="Amber Jewelry"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-primary-900/80 via-primary-900/30 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-6 text-bg-base">
          <p class="text-xs uppercase tracking-[0.3em] text-accent-300 mb-1 font-sans">
            {t('nav.amber')}
          </p>
          <h3 class="text-2xl font-serif mb-2">{t('home.cat_amber_title')}</h3>
          <p class="text-sm text-bg-base/80 mb-3">{t('home.cat_amber_desc')}</p>
          <span class="text-sm text-accent-300 group-hover:translate-x-1 transition-transform inline-block">
            {t('home.cat_explore')} →
          </span>
        </div>
      </a>

      <a href="/products?cat=incense" class="group relative aspect-[4/3] rounded-card overflow-hidden bg-primary-100">
        <img
          src="https://picsum.photos/seed/category-eastern-incense/1200/900"
          alt="Eastern Incense"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-primary-900/80 via-primary-900/30 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-6 text-bg-base">
          <p class="text-xs uppercase tracking-[0.3em] text-accent-300 mb-1 font-sans">
            {t('nav.incense')}
          </p>
          <h3 class="text-2xl font-serif mb-2">{t('home.cat_incense_title')}</h3>
          <p class="text-sm text-bg-base/80 mb-3">{t('home.cat_incense_desc')}</p>
          <span class="text-sm text-accent-300 group-hover:translate-x-1 transition-transform inline-block">
            {t('home.cat_explore')} →
          </span>
        </div>
      </a>
    </div>
  </div>
</section>

<!-- 3. Featured Products grid — 4 個 D1 真實產品 -->
<section class="py-10 bg-primary-100/30">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex flex-col md:flex-row items-center md:items-end justify-between mb-6 gap-4">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-accent-700 font-sans mb-2">
          {t('home.featured_kicker')}
        </p>
        <h2 class="text-2xl md:text-3xl font-serif text-text-primary">
          {t('home.featured_title')}
        </h2>
      </div>
      <a href="/products" class="text-accent-700 hover:underline text-sm">
        {t('home.featured_view_all')} →
      </a>
    </div>

    {featured.results.length === 0 ? (
      <p class="text-center text-text-muted py-8">{t('home.featured_empty')}</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {featured.results.map((p) => (
          <ProductCard
            slug={p.slug}
            name={p.name ?? p.slug}
            shortDescription={p.short_description ?? undefined}
            category={p.category}
            imageUrl={firstImage(p.image_urls)}
            priceFrom={p.min_price ? `${p.min_price / 100} ${p.min_currency}` : undefined}
          />
        ))}
      </div>
    )}
  </div>
</section>

<!-- 4. CTA — quiz entry -->
<section class="py-10 bg-primary-900 text-bg-base">
  <div class="max-w-3xl mx-auto px-6 text-center">
    <p class="text-xs uppercase tracking-[0.3em] text-accent-300 mb-2 font-sans">
      {t('home.cta_kicker')}
    </p>
    <h2 class="text-2xl md:text-3xl font-serif mb-3">{t('home.cta_title')}</h2>
    <p class="text-base text-bg-base/80 mb-6">{t('home.cta_desc')}</p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/quiz/jewelry" class="px-7 py-2.5 bg-bg-base text-primary-900 font-medium rounded-md hover:bg-accent-300 transition-colors">
        {t('home.cta_quiz_jewelry')}
      </a>
      <a href="/quiz/incense" class="px-7 py-2.5 border border-bg-base/40 text-bg-base font-medium rounded-md hover:bg-bg-base hover:text-primary-900 transition-colors">
        {t('home.cta_quiz_incense')}
      </a>
    </div>
  </div>
</section>

<!-- 5. Brand story -->
<section class="py-10 bg-bg-base">
  <div class="max-w-3xl mx-auto px-6 text-center">
    <p class="text-xs uppercase tracking-[0.3em] text-accent-700 mb-2 font-sans">
      {t('home.story_kicker')}
    </p>
    <h2 class="text-2xl md:text-3xl font-serif text-text-primary mb-4">
      {t('home.story_title')}
    </h2>
    <div class="space-y-3 text-base text-text-secondary font-sans leading-relaxed">
      <p>{t('home.story_p1')}</p>
      <p>{t('home.story_p2')}</p>
      <p class="text-text-muted italic text-sm">{t('home.story_note')}</p>
    </div>
  </div>
</section>

<!-- 6. Footer -->
<footer class="py-8 bg-primary-900 text-bg-base">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <p class="font-serif text-base mb-2">{t('common.site_name')}</p>
    <p class="text-xs text-bg-base/70 font-sans">
      {t('home.footer_rights')}
    </p>
    <p class="text-[10px] text-bg-base/50 mt-1 font-sans">
      {t('home.footer_tagline')}
    </p>
  </div>
</footer>