---
import Leaf from './Leaf.astro';
import { createT } from '../i18n/t';
import { defaultLocale, type Locale } from '../i18n/config';

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);
void locale;
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0 -z-10">
    <Leaf />
  </div>

  <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
    <p class="text-sm md:text-base uppercase tracking-[0.3em] text-accent-300 mb-6 font-sans">
      {t('home.hero_kicker')}
    </p>

    <h1 class="text-display-sm md:text-display md:text-display-md text-white drop-shadow-lg font-serif mb-6">
      {t('home.hero_title')}
    </h1>

    <p class="text-2xl md:text-3xl text-white/90 font-serif italic mb-12">
      {t('home.hero_subtitle')}
    </p>

    <div class="max-w-2xl mx-auto text-white/80 text-lg leading-relaxed font-sans space-y-4">
      <p>{t('home.hero_p1')}</p>
      <p>{t('home.hero_p2')}</p>
      <p>{t('home.hero_p3')}</p>
    </div>
  </div>
</section>

<section class="py-section bg-bg-base">
  <div class="max-w-3xl mx-auto px-6 text-center">
    <p class="text-sm uppercase tracking-[0.3em] text-accent-700 mb-4 font-sans">
      {t('home.story_kicker')}
    </p>

    <h2 class="text-display-sm md:text-display-md font-serif text-text-primary mb-8">
      {t('home.story_title')}
    </h2>

    <div class="space-y-6 text-lg text-text-secondary font-sans leading-relaxed">
      <p>{t('home.story_p1')}</p>
      <p>{t('home.story_p2')}</p>
      <p class="text-text-muted italic">{t('home.story_note')}</p>
    </div>
  </div>
</section>

<footer class="py-12 bg-primary-900 text-bg-base">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <p class="font-serif text-xl mb-3">{t('common.site_name')}</p>
    <p class="text-sm text-bg-base/70 font-sans">
      {t('home.footer_rights')}
    </p>
    <p class="text-xs text-bg-base/50 mt-2 font-sans">
      {t('home.footer_tagline')}
    </p>
  </div>
</footer>