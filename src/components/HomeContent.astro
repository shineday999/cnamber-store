---
import { env } from "cloudflare:workers";

// HomeContent — 2026-10-01 Awwwards-tier hero (year badge, scroll indicator, slide dots, stagger reveal)
// Inline footer 移除 — 改由 Layout.astro 透過 <Footer /> 全站統一渲染
import ProductCard from "@components/ProductCard.astro";
import RevealOnScroll from "@components/RevealOnScroll.astro";
import { createT } from "../i18n/t";
import { formatPrice } from "../lib/format";
import { localizedPath, defaultLocale, type Locale } from "../i18n/config";

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);

// Wave 28.7f: 首頁 hero 大標 + 副標題 從 D1 site_settings 讀
// (admin 編輯即時生效,4 語各自獨立,缺值 fallback i18n home.hero_title/subtitle)
const siteSettings = Astro.locals.siteSettings;
const heroTitle =
  siteSettings?.siteName?.[locale] ??
  siteSettings?.siteName?.["zh-Hans"] ??
  t("home.hero_title");
const heroSubtitle =
  siteSettings?.heroSubtitle?.[locale] ??
  siteSettings?.heroSubtitle?.["zh-Hans"] ??
  t("home.hero_subtitle");

interface FeaturedProduct {
  id: string;
  slug: string;
  category: string;
  name: string | null;
  short_description: string | null;
  min_price: number | null;
  min_currency: string | null;
  image_urls: string | null;
}

const featured = env?.DB
  ? await env.DB.prepare(
      `SELECT p.id, p.slug, p.category,
                pt.name, pt.short_description,
                MIN(pp.amount) AS min_price, pp.currency AS min_currency,
                (SELECT pv.image_urls FROM product_variants pv WHERE pv.product_id = p.id LIMIT 1) AS image_urls
         FROM products p
         LEFT JOIN product_translations pt ON pt.product_id = p.id AND pt.locale = ?
         LEFT JOIN product_variants pv ON pv.product_id = p.id
         LEFT JOIN product_prices pp ON pp.variant_id = pv.id
         WHERE p.status = 'active'
         GROUP BY p.id
         ORDER BY p.created_at DESC LIMIT 3`,
    )
      .bind(locale)
      .all<FeaturedProduct>()
  : { results: [] as FeaturedProduct[] };

function firstImage(json: string | null | undefined): string | undefined {
  if (!json) return undefined;
  try {
    const urls = JSON.parse(json) as string[];
    return Array.isArray(urls) && urls.length > 0 ? urls[0] : undefined;
  } catch {
    return undefined;
  }
}

const bannerRows = env?.DB
  ? await env.DB.prepare(
      "SELECT id, image_url, mobile_image_url, alt_text FROM hero_banners WHERE active = 1 ORDER BY sort_order ASC, created_at ASC",
    ).all<{
      id: string;
      image_url: string;
      mobile_image_url: string | null;
      alt_text: string | null;
    }>()
  : {
      results: [] as Array<{
        id: string;
        image_url: string;
        mobile_image_url: string | null;
        alt_text: string | null;
      }>,
    };

const slides = bannerRows.results.map((b) => ({
  src: b.image_url,
  // Wave 65: 真實 mobile variant (real responsive LCP 縮小);fallback desktop src
  mobileSrc: b.mobile_image_url ?? b.image_url,
  alt: b.alt_text ?? "",
}));
---

<!-- 1. Hero — Awwwards-tier: year badge, scroll indicator, slide dots, stagger reveal -->
<section
  data-home-hero
  class="relative h-[88vh] min-h-[640px] overflow-hidden bg-forest-900 text-cream-50"
>
  <div class="absolute inset-0">
    {
      slides.map((slide, i) => (
        <picture>
          {/*
            Wave 64 responsive LCP semantic: <picture> + <source media> + <img> fallback.
            目前 srcset 只有 1 個 1920w descriptor (banner 原圖 1920x1080 per Wave 26 hint).
            真實 mobile variant (e.g. 768w webp) 需 Wave 65+ — 要 admin upload mobile variant
            + D1 schema `mobile_image_url` column + 後端 image variant API,或
            Cloudflare cf-image-resizing (Pro plan + DNS zone config,非 code scope).
            此處 semantic 改進對 SEO + a11y + future-ready 有好處,browser 知道 image intrinsic width.
          */}
          <source
            media="(max-width: 768px)"
            srcset={`${slide.mobileSrc} ${slide.mobileSrc === slide.src ? "1920w" : "768w"}`}
            sizes="100vw"
            type="image/jpeg"
          />
          <source
            media="(min-width: 769px)"
            srcset={`${slide.src} 1920w`}
            sizes="100vw"
            type="image/jpeg"
          />
          <img
            decoding="async"
            data-hero-slide
            data-slide-index={i}
            src={slide.src}
            alt={slide.alt}
            class={`hero-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-[1800ms] ease-out ${i === 0 ? "opacity-85 hero-slide-active" : "opacity-0"}`}
            loading={i === 0 ? "eager" : "lazy"}
            fetchpriority={i === 0 ? "high" : "auto"}
          />
        </picture>
      ))
    }
    <div
      class="absolute inset-0 bg-gradient-to-br from-forest-900/90 via-forest-900/55 to-forest-900/95"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-t from-forest-900/80 via-forest-900/30 to-transparent"
    >
    </div>
  </div>

  <script is:inline>
    (function () {
      const slides = document.querySelectorAll("[data-hero-slide]");
      if (slides.length <= 1) return;
      const dots = document.querySelectorAll("[data-hero-dot]");
      let i = 0;
      function show(n) {
        slides.forEach((s, idx) => {
          s.style.opacity = idx === n ? "0.85" : "0";
          s.classList.toggle("hero-slide-active", idx === n);
        });
        dots.forEach((d, idx) => {
          d.classList.toggle("hero-dot-active", idx === n);
        });
      }
      // Respect prefers-reduced-motion: skip auto-rotation entirely.
      // CSS already kills the crossfade (transition-duration 0.01ms), but
      // we also stop the JS interval so the user doesn't see the slide
      // content swap underneath their reading. Dot click still works.
      const prefersReduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      if (!prefersReduced) {
        setInterval(() => {
          i = (i + 1) % slides.length;
          show(i);
        }, 15000);
      }
      dots.forEach((dot, idx) => {
        dot.addEventListener("click", () => {
          i = idx;
          show(i);
        });
      });
    })();
  </script>

  <!-- Top metadata strip -->
  <div
    class="absolute top-0 left-0 right-0 z-20 px-6 md:px-12 pt-6 md:pt-8 flex items-start justify-between text-cream-100/85 font-sans text-[10px] uppercase tracking-[0.4em]"
  >
    <div class="hidden md:block text-right text-cream-100/70">
      {t("home.story_kicker")}
    </div>
  </div>

  <!-- Main content (stagger reveal via .hero-text) -->
  <div
    class="relative z-10 h-full grid grid-cols-12 items-center px-6 md:px-12 max-w-7xl mx-auto"
  >
    <div class="col-span-12 md:col-span-9 hero-text">
      <p
        class="text-[10px] uppercase tracking-[0.5em] text-terra-300 mb-5 md:mb-7 font-sans"
      >
        {t("home.hero_kicker")}
      </p>
      <h1
        class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl xl:text-9xl font-serif font-light mb-5 md:mb-7 leading-[0.98] tracking-[-0.03em] text-balance text-cream-50"
      >
        {heroTitle}
      </h1>
      <p
        class="text-lg md:text-xl lg:text-2xl text-cream-100/85 font-serif italic font-light mb-9 md:mb-12 leading-snug max-w-2xl"
      >
        {heroSubtitle}
      </p>
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
        <a
          href={localizedPath(locale, "/products")}
          class="group inline-flex items-center justify-center gap-2 px-7 md:px-9 py-3.5 md:py-4 bg-terra-500 text-cream-50 font-sans text-sm tracking-wide rounded-sm hover:bg-terra-700 transition-all duration-700 hover:gap-3 magnetic"
        >
          {t("home.hero_cta_shop")}
          <span
            aria-hidden="true"
            class="transition-transform group-hover:translate-x-0.5">→</span
          >
        </a>
        <a
          href={localizedPath(locale, "/quiz")}
          class="inline-flex items-center justify-center gap-2 px-7 md:px-9 py-3.5 md:py-4 border border-cream-100/50 text-cream-50 font-sans text-sm tracking-wide rounded-sm hover:bg-cream-50/10 hover:border-cream-100 transition-all duration-700"
        >
          {t("home.hero_cta_quiz")}
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom: slide dots + scroll indicator -->
  <div
    class="absolute bottom-0 left-0 right-0 z-20 px-6 md:px-12 pb-6 md:pb-8 flex items-end justify-between text-cream-100/85"
  >
    <div
      class="flex items-center gap-2.5"
      role="tablist"
      aria-label="Hero slides"
    >
      {
        slides.map((_, i) => (
          <button
            type="button"
            data-hero-dot
            class={`hero-dot ${i === 0 ? "hero-dot-active" : ""}`}
            aria-label={`Slide ${i + 1}`}
          />
        ))
      }
    </div>
    <a
      href="#below-hero"
      class="hidden md:flex flex-col items-center gap-1.5 text-cream-100/65 hover:text-cream-50 transition-colors"
      aria-label="Scroll down"
    >
      <span class="text-[10px] uppercase tracking-[0.4em] font-sans"
        >Scroll</span
      >
      <svg
        class="w-4 h-4 scroll-indicator"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </a>
  </div>
</section>

<!-- invisible anchor target for hero scroll indicator -->
<a id="below-hero" aria-hidden="true" class="block h-0"></a>

<!-- 2. Two craft paths (5/7 + 7/5 asymmetric) + inline Find Yours CTA at bottom -->
<section data-home-paths class="py-section relative">
  <div class="relative max-w-6xl mx-auto px-6">
    <RevealOnScroll>
      <div class="mb-12 max-w-xl">
        <p
          class="text-[10px] uppercase tracking-[0.4em] text-forest-600 font-sans mb-3"
        >
          {t("home.categories_kicker")}
        </p>
        <h2
          class="text-3xl md:text-4xl font-serif font-light text-forest-800 leading-[1.05] tracking-tight"
        >
          {t("home.categories_title")}
        </h2>
      </div>
    </RevealOnScroll>

    <div class="grid grid-cols-12 gap-5 md:gap-6 items-start">
      <RevealOnScroll class="col-span-12 md:col-span-5">
        <a
          href={localizedPath(locale, "/products?cat=jewelry")}
          class="group relative block aspect-[4/5] overflow-hidden bg-forest-100 rounded-sm hover-lift"
        >
          <img
            decoding="async"
            src="/images/banners/cat-jewelry.jpg"
            alt={t("home.cat_amber_alt")}
            class="w-full h-full object-cover cinematic group-hover:scale-[1.06] transition-transform duration-[1400ms] ease-out"
            loading="lazy"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-forest-900/90 via-forest-900/40 to-transparent"
          >
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-7 text-cream-50">
            <p
              class="text-[10px] uppercase tracking-[0.4em] text-terra-300 mb-2 font-sans"
            >
              {t("nav.amber")}
            </p>
            <h3
              class="text-2xl md:text-3xl font-serif font-light mb-2 leading-tight"
            >
              {t("home.cat_amber_title")}
            </h3>
            <p
              class="text-sm text-cream-100/80 mb-3 font-sans leading-relaxed max-w-sm"
            >
              {t("home.cat_amber_desc")}
            </p>
            <span
              class="text-xs text-terra-300 border-b border-terra-300/40 pb-0.5 group-hover:border-terra-300 transition-colors tracking-wide font-sans"
            >
              {t("home.cat_explore")} →
            </span>
          </div>
        </a>
      </RevealOnScroll>

      <RevealOnScroll delay={150} class="col-span-12 md:col-span-7 md:mt-16">
        <a
          href={localizedPath(locale, "/products?cat=incense")}
          class="group relative block aspect-[4/5] overflow-hidden bg-forest-100 rounded-sm hover-lift"
        >
          <img
            decoding="async"
            src="/images/banners/cat-incense.jpg"
            alt={t("home.cat_incense_alt")}
            class="w-full h-full object-cover cinematic group-hover:scale-[1.06] transition-transform duration-[1400ms] ease-out"
            loading="lazy"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-forest-900/90 via-forest-900/40 to-transparent"
          >
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-7 text-cream-50">
            <p
              class="text-[10px] uppercase tracking-[0.4em] text-terra-300 mb-2 font-sans"
            >
              {t("nav.incense")}
            </p>
            <h3
              class="text-2xl md:text-3xl font-serif font-light mb-2 leading-tight"
            >
              {t("home.cat_incense_title")}
            </h3>
            <p
              class="text-sm text-cream-100/80 mb-3 font-sans leading-relaxed max-w-sm"
            >
              {t("home.cat_incense_desc")}
            </p>
            <span
              class="text-xs text-terra-300 border-b border-terra-300/40 pb-0.5 group-hover:border-terra-300 transition-colors tracking-wide font-sans"
            >
              {t("home.cat_explore")} →
            </span>
          </div>
        </a>
      </RevealOnScroll>
    </div>

    <!-- Find yours — 2 quiz cards -->
    <div class="mt-20 pt-12 border-t border-forest-100">
      <RevealOnScroll>
        <div class="text-center mb-10 max-w-xl mx-auto">
          <p
            class="text-[10px] uppercase tracking-[0.4em] text-forest-600 font-sans mb-3"
          >
            {t("home.cta_kicker")}
          </p>
          <h2
            class="text-3xl md:text-4xl font-serif font-light text-forest-800 leading-[1.05] tracking-tight mb-4"
          >
            {t("home.cta_title")}
          </h2>
          <p class="text-text-secondary leading-relaxed font-sans">
            {t("home.cta_desc")}
          </p>
        </div>
      </RevealOnScroll>

      <div
        class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6 max-w-4xl mx-auto"
      >
        <RevealOnScroll>
          <a
            href={localizedPath(locale, "/quiz/jewelry")}
            class="group block h-full p-7 md:p-9 bg-bg-base border border-forest-100 hover:border-forest-300 rounded-card transition-all duration-500 hover:shadow-soft-lg hover-lift"
          >
            <div class="flex items-center gap-2.5 mb-4">
              <svg
                viewBox="0 0 24 24"
                class="w-5 h-5 text-terra-500"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path
                  d="M12 3 C 7 11, 4 17, 8 21 L 16 21 C 20 17, 17 11, 12 3 Z"
                ></path>
              </svg>
              <span
                class="text-[10px] uppercase tracking-[0.4em] text-terra-500 font-sans"
              >
                {t("nav.amber")}
              </span>
            </div>
            <h3
              class="text-2xl md:text-3xl font-serif font-light text-forest-800 mb-3 leading-tight"
            >
              {t("home.cta_quiz_jewelry")}
            </h3>
            <p class="text-text-secondary mb-4 leading-relaxed font-sans">
              {t("home.cta_jewelry_desc")}
            </p>
            <p class="text-xs text-text-muted font-sans mb-6 tracking-wide">
              {t("home.cta_meta")}
            </p>
            <span
              class="inline-flex items-center gap-1.5 text-sm text-forest-700 font-sans tracking-wide group-hover:gap-2.5 transition-all"
            >
              {t("home.cta_jewelry_btn")}
              <span aria-hidden="true">→</span>
            </span>
          </a>
        </RevealOnScroll>

        <RevealOnScroll delay={120}>
          <a
            href={localizedPath(locale, "/quiz/incense")}
            class="group block h-full p-7 md:p-9 bg-bg-base border border-forest-100 hover:border-forest-300 rounded-card transition-all duration-500 hover:shadow-soft-lg hover-lift"
          >
            <div class="flex items-center gap-2.5 mb-4">
              <svg
                viewBox="0 0 24 24"
                class="w-5 h-5 text-terra-500"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M12 3 Q 10 7 12 11 Q 14 15 12 19"></path>
                <path d="M8 5 Q 6.5 8 8 11"></path>
                <path d="M16 5 Q 17.5 8 16 11"></path>
              </svg>
              <span
                class="text-[10px] uppercase tracking-[0.4em] text-terra-500 font-sans"
              >
                {t("nav.incense")}
              </span>
            </div>
            <h3
              class="text-2xl md:text-3xl font-serif font-light text-forest-800 mb-3 leading-tight"
            >
              {t("home.cta_quiz_incense")}
            </h3>
            <p class="text-text-secondary mb-4 leading-relaxed font-sans">
              {t("home.cta_incense_desc")}
            </p>
            <p class="text-xs text-text-muted font-sans mb-6 tracking-wide">
              {t("home.cta_meta")}
            </p>
            <span
              class="inline-flex items-center gap-1.5 text-sm text-forest-700 font-sans tracking-wide group-hover:gap-2.5 transition-all"
            >
              {t("home.cta_incense_btn")}
              <span aria-hidden="true">→</span>
            </span>
          </a>
        </RevealOnScroll>
      </div>
    </div>
  </div>
</section>

<!-- 3. Recent highlights — 3 small cards in single row, compact -->
<section data-home-featured class="py-section relative">
  <div class="relative max-w-6xl mx-auto px-6">
    <RevealOnScroll>
      <div
        class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-3"
      >
        <div>
          <p
            class="text-[10px] uppercase tracking-[0.4em] text-forest-600 font-sans mb-3"
          >
            {t("home.featured_kicker")}
          </p>
          <h2
            class="text-3xl md:text-4xl font-serif font-light text-forest-800 leading-[1.05] tracking-tight"
          >
            {t("home.featured_title")}
          </h2>
        </div>
        <a
          href={localizedPath(locale, "/products")}
          class="text-xs text-forest-700 hover:text-terra-500 transition-colors border-b border-forest-200 pb-1 self-start md:self-auto tracking-wide font-sans link-underline"
        >
          {t("home.featured_view_all")} →
        </a>
      </div>
    </RevealOnScroll>

    {
      featured.results.length === 0 ? (
        <p class="text-center text-forest-600 py-8 font-light">
          {t("home.featured_empty")}
        </p>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          {featured.results[0] && (
            <RevealOnScroll class="h-full">
              <ProductCard
                slug={featured.results[0].slug}
                name={featured.results[0].name ?? featured.results[0].slug}
                shortDescription={
                  featured.results[0].short_description ?? undefined
                }
                category={featured.results[0].category}
                imageUrl={firstImage(featured.results[0].image_urls)}
                priceFrom={
                  featured.results[0].min_price
                    ? formatPrice(
                        featured.results[0].min_price ?? 0,
                        featured.results[0].min_currency ?? "USD",
                        locale,
                      )
                    : undefined
                }
                variant="compact"
              />
            </RevealOnScroll>
          )}
          {featured.results[1] && (
            <RevealOnScroll delay={100} class="h-full">
              <ProductCard
                slug={featured.results[1].slug}
                name={featured.results[1].name ?? featured.results[1].slug}
                shortDescription={
                  featured.results[1].short_description ?? undefined
                }
                category={featured.results[1].category}
                imageUrl={firstImage(featured.results[1].image_urls)}
                priceFrom={
                  featured.results[1].min_price
                    ? formatPrice(
                        featured.results[1].min_price ?? 0,
                        featured.results[1].min_currency ?? "USD",
                        locale,
                      )
                    : undefined
                }
                variant="compact"
              />
            </RevealOnScroll>
          )}
          {featured.results[2] && (
            <RevealOnScroll delay={200} class="h-full">
              <ProductCard
                slug={featured.results[2].slug}
                name={featured.results[2].name ?? featured.results[2].slug}
                shortDescription={
                  featured.results[2].short_description ?? undefined
                }
                category={featured.results[2].category}
                imageUrl={firstImage(featured.results[2].image_urls)}
                priceFrom={
                  featured.results[2].min_price
                    ? formatPrice(
                        featured.results[2].min_price ?? 0,
                        featured.results[2].min_currency ?? "USD",
                        locale,
                      )
                    : undefined
                }
                variant="compact"
              />
            </RevealOnScroll>
          )}
        </div>
      )
    }
  </div>
</section>

<!-- Footer removed — now rendered globally by Layout.astro via <Footer /> -->
