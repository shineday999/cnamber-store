---
// HomeContent — 3 區塊 · 緊湊版面 · 大量留白
import ProductCard from "@components/ProductCard.astro";
import RevealOnScroll from "./RevealOnScroll.astro";
import { createT } from "../i18n/t";
import { defaultLocale, type Locale } from "../i18n/config";

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);
void locale;

const env = Astro.locals.runtime?.env;

interface FeaturedProduct {
  id: string;
  slug: string;
  category: string;
  name: string | null;
  short_description: string | null;
  min_price: number | null;
  min_currency: string | null;
  image_urls: string | null;
}

const featured = env?.DB
  ? await env.DB.prepare(
      `SELECT p.id, p.slug, p.category,
                pt.name, pt.short_description,
                MIN(pp.amount) AS min_price, pp.currency AS min_currency,
                (SELECT pv.image_urls FROM product_variants pv WHERE pv.product_id = p.id LIMIT 1) AS image_urls
         FROM products p
         LEFT JOIN product_translations pt ON pt.product_id = p.id AND pt.locale = ?
         LEFT JOIN product_variants pv ON pv.product_id = p.id
         LEFT JOIN product_prices pp ON pp.variant_id = pv.id
         WHERE p.status = 'active'
         GROUP BY p.id
         ORDER BY p.created_at DESC LIMIT 3`,
    )
      .bind(locale)
      .all<FeaturedProduct>()
  : { results: [] as FeaturedProduct[] };

function firstImage(json: string | null | undefined): string | undefined {
  if (!json) return undefined;
  try {
    const urls = JSON.parse(json) as string[];
    return Array.isArray(urls) && urls.length > 0 ? urls[0] : undefined;
  } catch {
    return undefined;
  }
}
---

<!-- 1. Hero — compact 65vh -->
<section
  class="relative h-[65vh] min-h-[480px] overflow-hidden bg-forest-800 text-cream-50"
>
  <div class="absolute inset-0 animate-breathe">
    <img
      src="https://picsum.photos/seed/cnamber-forest-canopy/1920/1080"
      alt=""
      class="w-full h-full object-cover opacity-60 cinematic scale-110"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div
    class="absolute inset-0 bg-gradient-to-br from-forest-900/70 via-forest-800/30 to-forest-900/80"
  >
  </div>

  <div
    class="relative z-10 h-full grid grid-cols-12 items-center px-6 md:px-12 max-w-6xl mx-auto"
  >
    <div class="col-span-12 md:col-span-7 animate-fade-up">
      <p
        class="text-[10px] uppercase tracking-[0.4em] text-terra-300 mb-4 font-sans"
      >
        {t("home.hero_kicker")}
      </p>
      <h1
        class="text-4xl md:text-6xl lg:text-7xl font-serif font-light text-cream-50 mb-3 leading-[1.02] tracking-tight"
      >
        {t("home.hero_title")}
      </h1>
      <p
        class="text-lg md:text-xl text-cream-100/80 font-serif italic font-light mb-8 leading-snug"
      >
        {t("home.hero_subtitle")}
      </p>
      <div class="flex flex-col sm:flex-row gap-2 sm:gap-3">
        <a
          href="/products"
          class="inline-block px-8 py-3 bg-terra-500 text-cream-50 font-sans text-sm tracking-wide rounded-sm hover:bg-terra-700 transition-all duration-700 text-center"
        >
          {t("home.hero_cta_shop")} →
        </a>
        <a
          href="/quiz"
          class="inline-block px-8 py-3 border border-cream-100/40 text-cream-50 font-sans text-sm tracking-wide rounded-sm hover:bg-cream-50/10 transition-all duration-700 text-center"
        >
          {t("home.hero_cta_quiz")}
        </a>
      </div>
    </div>
  </div>
</section>

<!-- 2. Two craft paths (5/7 + 7/5 asymmetric) + inline Find Yours CTA at bottom -->
<section class="py-12 md:py-14 relative">
  <div class="relative max-w-6xl mx-auto px-6">
    <RevealOnScroll>
      <div class="mb-8 max-w-xl">
        <p
          class="text-[10px] uppercase tracking-[0.4em] text-forest-400 font-sans mb-2"
        >
          {t("home.categories_kicker")}
        </p>
        <h2
          class="text-2xl md:text-4xl font-serif font-light text-forest-800 leading-[1.1] tracking-tight"
        >
          {t("home.categories_title")}
        </h2>
      </div>
    </RevealOnScroll>

    <div class="grid grid-cols-12 gap-5 md:gap-6 items-start">
      <RevealOnScroll class="col-span-12 md:col-span-5">
        <a
          href="/products?cat=jewelry"
          class="group relative block aspect-[4/5] overflow-hidden bg-forest-100 rounded-sm"
        >
          <img
            src="https://picsum.photos/seed/cnamber-amber-on-linen/800/1000"
            alt="Amber Jewelry"
            class="w-full h-full object-cover cinematic group-hover:scale-[1.05] transition-transform duration-[1400ms] ease-out"
            loading="lazy"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-forest-900/90 via-forest-900/40 to-transparent"
          >
          </div>

          <div class="absolute bottom-0 left-0 right-0 p-6 text-cream-50">
            <p
              class="text-[10px] uppercase tracking-[0.4em] text-terra-300 mb-1.5 font-sans"
            >
              {t("nav.amber")}
            </p>
            <h3 class="text-2xl font-serif font-light mb-2 leading-tight">
              {t("home.cat_amber_title")}
            </h3>
            <span
              class="text-xs text-terra-300 border-b border-terra-300/40 pb-0.5 group-hover:border-terra-300 transition-colors tracking-wide font-sans"
              >{t("home.cat_explore")} →</span
            >
          </div>
        </a>
      </RevealOnScroll>

      <RevealOnScroll delay={200} class="col-span-12 md:col-span-7 md:mt-16">
        <a
          href="/products?cat=incense"
          class="group relative block aspect-[4/5] overflow-hidden bg-forest-100 rounded-sm"
        >
          <img
            src="https://picsum.photos/seed/cnamber-incense-and-figure/800/1000"
            alt="Eastern Incense"
            class="w-full h-full object-cover cinematic group-hover:scale-[1.05] transition-transform duration-[1400ms] ease-out"
            loading="lazy"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-forest-900/90 via-forest-900/40 to-transparent"
          >
          </div>

          <div class="absolute bottom-0 left-0 right-0 p-6 text-cream-50">
            <p
              class="text-[10px] uppercase tracking-[0.4em] text-terra-300 mb-1.5 font-sans"
            >
              {t("nav.incense")}
            </p>
            <h3 class="text-2xl font-serif font-light mb-2 leading-tight">
              {t("home.cat_incense_title")}
            </h3>
            <span
              class="text-xs text-terra-300 border-b border-terra-300/40 pb-0.5 group-hover:border-terra-300 transition-colors tracking-wide font-sans"
              >{t("home.cat_explore")} →</span
            >
          </div>
        </a>
      </RevealOnScroll>
    </div>

    <!-- Inline Find Yours CTA — compact, integrated with categories -->
    <div
      class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-4 border-t border-forest-100 pt-8"
    >
      <p class="text-base text-forest-600 font-serif italic">
        {t("home.cta_title")}
      </p>
      <div class="flex gap-2">
        <a
          href="/quiz/jewelry"
          class="px-5 py-2 bg-forest-700 text-cream-50 text-xs tracking-wide rounded-sm hover:bg-forest-800 transition-all duration-500"
          >{t("home.cta_quiz_jewelry")}</a
        >
        <a
          href="/quiz/incense"
          class="px-5 py-2 border border-forest-300 text-forest-700 text-xs tracking-wide rounded-sm hover:bg-cream-100 transition-all duration-500"
          >{t("home.cta_quiz_incense")}</a
        >
      </div>
    </div>
  </div>
</section>

<!-- 3. Recent highlights — 3 small cards in single row, compact -->
<section class="py-10 md:py-12 relative">
  <div class="relative max-w-6xl mx-auto px-6">
    <RevealOnScroll>
      <div
        class="flex flex-col md:flex-row md:items-end justify-between mb-6 gap-3"
      >
        <div>
          <p
            class="text-[10px] uppercase tracking-[0.4em] text-forest-400 font-sans mb-2"
          >
            {t("home.featured_kicker")}
          </p>
          <h2
            class="text-2xl md:text-3xl font-serif font-light text-forest-800 leading-[1.1] tracking-tight"
          >
            {t("home.featured_title")}
          </h2>
        </div>
        <a
          href="/products"
          class="text-xs text-forest-500 hover:text-terra-500 transition-colors border-b border-forest-200 pb-0.5 self-start md:self-auto tracking-wide font-sans"
        >
          {t("home.featured_view_all")} →
        </a>
      </div>
    </RevealOnScroll>

    {
      featured.results.length === 0 ? (
        <p class="text-center text-forest-400 py-6 font-light">
          {t("home.featured_empty")}
        </p>
      ) : (
        <div class="grid grid-cols-3 gap-4">
          {featured.results[0] && (
            <RevealOnScroll class="col-span-3 sm:col-span-1">
              <ProductCard
                slug={featured.results[0].slug}
                name={featured.results[0].name ?? featured.results[0].slug}
                shortDescription={
                  featured.results[0].short_description ?? undefined
                }
                category={featured.results[0].category}
                imageUrl={firstImage(featured.results[0].image_urls)}
                priceFrom={
                  featured.results[0].min_price
                    ? `${featured.results[0].min_price / 100} ${featured.results[0].min_currency}`
                    : undefined
                }
                variant="compact"
              />
            </RevealOnScroll>
          )}
          {featured.results[1] && (
            <RevealOnScroll delay={100} class="col-span-3 sm:col-span-1">
              <ProductCard
                slug={featured.results[1].slug}
                name={featured.results[1].name ?? featured.results[1].slug}
                shortDescription={
                  featured.results[1].short_description ?? undefined
                }
                category={featured.results[1].category}
                imageUrl={firstImage(featured.results[1].image_urls)}
                priceFrom={
                  featured.results[1].min_price
                    ? `${featured.results[1].min_price / 100} ${featured.results[1].min_currency}`
                    : undefined
                }
                variant="compact"
              />
            </RevealOnScroll>
          )}
          {featured.results[2] && (
            <RevealOnScroll delay={200} class="col-span-3 sm:col-span-1">
              <ProductCard
                slug={featured.results[2].slug}
                name={featured.results[2].name ?? featured.results[2].slug}
                shortDescription={
                  featured.results[2].short_description ?? undefined
                }
                category={featured.results[2].category}
                imageUrl={firstImage(featured.results[2].image_urls)}
                priceFrom={
                  featured.results[2].min_price
                    ? `${featured.results[2].min_price / 100} ${featured.results[2].min_currency}`
                    : undefined
                }
                variant="compact"
              />
            </RevealOnScroll>
          )}
        </div>
      )
    }
  </div>
</section>

<!-- Footer — minimal -->
<footer class="py-8 bg-forest-800 text-cream-100">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <p class="font-serif text-sm mb-1.5 font-light">{t("common.site_name")}</p>
    <p class="text-xs text-cream-100/60 font-sans">{t("home.footer_rights")}</p>
  </div>
</footer>
