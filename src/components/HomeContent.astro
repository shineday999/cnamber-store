---
// HomeContent — 4 區塊 max · 非對稱 grid · Cormorant Garamond 標題 · 大量留白
import Layout from '@layouts/Layout.astro';
import ProductCard from '@components/ProductCard.astro';
import RevealOnScroll from './RevealOnScroll.astro';
import { createT } from '../i18n/t';
import { defaultLocale, type Locale } from '../i18n/config';

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);
void locale;

const env = Astro.locals.runtime?.env;

interface FeaturedProduct {
  id: string;
  slug: string;
  category: string;
  name: string | null;
  short_description: string | null;
  min_price: number | null;
  min_currency: string | null;
  image_urls: string | null;
}

const featured = env?.DB
  ? await env.DB
      .prepare(
        `SELECT p.id, p.slug, p.category,
                pt.name, pt.short_description,
                MIN(pp.amount) AS min_price, pp.currency AS min_currency,
                (SELECT pv.image_urls FROM product_variants pv WHERE pv.product_id = p.id LIMIT 1) AS image_urls
         FROM products p
         LEFT JOIN product_translations pt ON pt.product_id = p.id AND pt.locale = ?
         LEFT JOIN product_variants pv ON pv.product_id = p.id
         LEFT JOIN product_prices pp ON pp.variant_id = pv.id
         WHERE p.status = 'active'
         GROUP BY p.id
         ORDER BY p.created_at DESC LIMIT 4`,
      )
      .bind(locale)
      .all<FeaturedProduct>()
  : { results: [] as FeaturedProduct[] };

function firstImage(json: string | null | undefined): string | undefined {
  if (!json) return undefined;
  try {
    const urls = JSON.parse(json) as string[];
    return Array.isArray(urls) && urls.length > 0 ? urls[0] : undefined;
  } catch {
    return undefined;
  }
}
---

<!-- 1. Hero — full-bleed forest + Cormorant title + asymmetric 7/5 layout -->
<section class="relative h-[88vh] min-h-[640px] overflow-hidden bg-forest-800 text-cream-50">
  <div class="absolute inset-0 animate-breathe">
    <img
      src="https://picsum.photos/seed/cnamber-forest-canopy/1920/1080"
      alt=""
      class="w-full h-full object-cover opacity-60 cinematic scale-110"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="absolute inset-0 bg-gradient-to-br from-forest-900/70 via-forest-800/30 to-forest-900/80"></div>
  <div class="bg-grain absolute inset-0 opacity-[0.08] pointer-events-none"></div>

  <div class="relative z-10 h-full grid grid-cols-12 items-center px-6 md:px-12 max-w-6xl mx-auto">
    <div class="col-span-12 md:col-span-7 animate-fade-up">
      <p class="text-xs uppercase tracking-[0.4em] text-terra-300 mb-5 font-sans">
        {t('home.hero_kicker')}
      </p>
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-serif font-light text-cream-50 mb-5 leading-[1.02] tracking-tight">
        {t('home.hero_title')}
      </h1>
      <p class="text-xl md:text-2xl text-cream-100/80 font-serif italic font-light mb-8 leading-snug">
        {t('home.hero_subtitle')}
      </p>
      <p class="text-cream-100/70 leading-relaxed mb-10 max-w-md font-light text-base">
        {t('home.hero_p1')}
      </p>
      <a href="/products" class="inline-block px-9 py-3.5 bg-terra-500 text-cream-50 font-sans text-sm tracking-wide rounded-sm hover:bg-terra-700 transition-all duration-700">
        {t('home.hero_cta_shop')} →
      </a>
    </div>
    <!-- Right 5 cols intentionally empty — Western editorial whitespace breathing -->
    <div class="hidden md:block md:col-span-5"></div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-cream-100/40 text-[10px] uppercase tracking-[0.4em] font-sans">
    Scroll
  </div>
</section>

<!-- 2. Two craft paths — asymmetric 5/7 + 7/5 grid with offset -->
<section class="py-20 md:py-24 bg-cream-50 relative">
  <div class="absolute inset-0 bg-paper opacity-[0.5] pointer-events-none"></div>
  <div class="relative max-w-6xl mx-auto px-6">
    <RevealOnScroll>
      <div class="mb-14 max-w-2xl">
        <p class="text-xs uppercase tracking-[0.4em] text-forest-400 font-sans mb-3">
          {t('home.categories_kicker')}
        </p>
        <h2 class="text-3xl md:text-5xl font-serif font-light text-forest-800 leading-[1.1] tracking-tight">
          {t('home.categories_title')}
        </h2>
      </div>
    </RevealOnScroll>

    <div class="grid grid-cols-12 gap-5 md:gap-6 items-start">
      <RevealOnScroll class="col-span-12 md:col-span-5">
        <a href="/products?cat=jewelry" class="group relative block aspect-[4/5] overflow-hidden bg-forest-100 rounded-sm">
          <img
            src="https://picsum.photos/seed/cnamber-amber-on-linen/800/1000"
            alt="Amber Jewelry"
            class="w-full h-full object-cover cinematic group-hover:scale-[1.05] transition-transform duration-[1400ms] ease-out"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-forest-900/90 via-forest-900/40 to-transparent"></div>
          <div class="bg-grain absolute inset-0 opacity-[0.06] pointer-events-none"></div>
          <div class="absolute bottom-0 left-0 right-0 p-7 text-cream-50">
            <p class="text-[10px] uppercase tracking-[0.4em] text-terra-300 mb-2 font-sans">
              {t('nav.amber')}
            </p>
            <h3 class="text-3xl font-serif font-light mb-3 leading-tight">
              {t('home.cat_amber_title')}
            </h3>
            <p class="text-sm text-cream-100/70 mb-4 leading-relaxed">
              {t('home.cat_amber_desc')}
            </p>
            <span class="text-xs text-terra-300 border-b border-terra-300/40 pb-0.5 group-hover:border-terra-300 transition-colors tracking-wide font-sans">
              {t('home.cat_explore')} →
            </span>
          </div>
        </a>
      </RevealOnScroll>

      <RevealOnScroll delay={200} class="col-span-12 md:col-span-7 md:mt-20">
        <a href="/products?cat=incense" class="group relative block aspect-[4/5] overflow-hidden bg-forest-100 rounded-sm">
          <img
            src="https://picsum.photos/seed/cnamber-incense-and-figure/800/1000"
            alt="Eastern Incense"
            class="w-full h-full object-cover cinematic group-hover:scale-[1.05] transition-transform duration-[1400ms] ease-out"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-forest-900/90 via-forest-900/40 to-transparent"></div>
          <div class="bg-grain absolute inset-0 opacity-[0.06] pointer-events-none"></div>
          <div class="absolute bottom-0 left-0 right-0 p-7 text-cream-50">
            <p class="text-[10px] uppercase tracking-[0.4em] text-terra-300 mb-2 font-sans">
              {t('nav.incense')}
            </p>
            <h3 class="text-3xl font-serif font-light mb-3 leading-tight">
              {t('home.cat_incense_title')}
            </h3>
            <p class="text-sm text-cream-100/70 mb-4 leading-relaxed">
              {t('home.cat_incense_desc')}
            </p>
            <span class="text-xs text-terra-300 border-b border-terra-300/40 pb-0.5 group-hover:border-terra-300 transition-colors tracking-wide font-sans">
              {t('home.cat_explore')} →
            </span>
          </div>
        </a>
      </RevealOnScroll>
    </div>
  </div>
</section>

<!-- 3. Recent highlights — asymmetric 7/5 + 5/7 grid (large + small + small + large) -->
<section class="py-20 md:py-24 bg-cream-100 relative">
  <div class="bg-paper absolute inset-0 opacity-[0.4] pointer-events-none"></div>
  <div class="relative max-w-6xl mx-auto px-6">
    <RevealOnScroll>
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <p class="text-xs uppercase tracking-[0.4em] text-forest-400 font-sans mb-3">
            {t('home.featured_kicker')}
          </p>
          <h2 class="text-3xl md:text-5xl font-serif font-light text-forest-800 leading-[1.1] tracking-tight">
            {t('home.featured_title')}
          </h2>
        </div>
        <a href="/products" class="text-xs text-forest-500 hover:text-terra-500 transition-colors border-b border-forest-200 pb-0.5 self-start md:self-auto tracking-wide font-sans">
          {t('home.featured_view_all')} →
        </a>
      </div>
    </RevealOnScroll>

    {featured.results.length === 0 ? (
      <p class="text-center text-forest-400 py-12 font-light">{t('home.featured_empty')}</p>
    ) : (
      <div class="grid grid-cols-12 gap-5">
        {featured.results[0] && (
          <RevealOnScroll class="col-span-12 md:col-span-7">
            <ProductCard
              slug={featured.results[0].slug}
              name={featured.results[0].name ?? featured.results[0].slug}
              shortDescription={featured.results[0].short_description ?? undefined}
              category={featured.results[0].category}
              imageUrl={firstImage(featured.results[0].image_urls)}
              priceFrom={featured.results[0].min_price ? `${featured.results[0].min_price / 100} ${featured.results[0].min_currency}` : undefined}
              variant="large"
            />
          </RevealOnScroll>
        )}
        {featured.results[1] && (
          <RevealOnScroll delay={120} class="col-span-12 md:col-span-5">
            <ProductCard
              slug={featured.results[1].slug}
              name={featured.results[1].name ?? featured.results[1].slug}
              shortDescription={featured.results[1].short_description ?? undefined}
              category={featured.results[1].category}
              imageUrl={firstImage(featured.results[1].image_urls)}
              priceFrom={featured.results[1].min_price ? `${featured.results[1].min_price / 100} ${featured.results[1].min_currency}` : undefined}
            />
          </RevealOnScroll>
        )}
        {featured.results[2] && (
          <RevealOnScroll delay={240} class="col-span-12 md:col-span-5">
            <ProductCard
              slug={featured.results[2].slug}
              name={featured.results[2].name ?? featured.results[2].slug}
              shortDescription={featured.results[2].short_description ?? undefined}
              category={featured.results[2].category}
              imageUrl={firstImage(featured.results[2].image_urls)}
              priceFrom={featured.results[2].min_price ? `${featured.results[2].min_price / 100} ${featured.results[2].min_currency}` : undefined}
            />
          </RevealOnScroll>
        )}
        {featured.results[3] && (
          <RevealOnScroll delay={360} class="col-span-12 md:col-span-7">
            <ProductCard
              slug={featured.results[3].slug}
              name={featured.results[3].name ?? featured.results[3].slug}
              shortDescription={featured.results[3].short_description ?? undefined}
              category={featured.results[3].category}
              imageUrl={firstImage(featured.results[3].image_urls)}
              priceFrom={featured.results[3].min_price ? `${featured.results[3].min_price / 100} ${featured.results[3].min_currency}` : undefined}
              variant="large"
            />
          </RevealOnScroll>
        )}
      </div>
    )}
  </div>
</section>

<!-- 4. Brand — compact, Find Yours + footer -->
<section class="py-20 md:py-24 bg-cream-50 relative">
  <div class="bg-paper absolute inset-0 opacity-[0.5] pointer-events-none"></div>
  <div class="relative max-w-2xl mx-auto px-6 text-center">
    <RevealOnScroll>
      <p class="text-xs uppercase tracking-[0.4em] text-forest-400 mb-4 font-sans">
        {t('home.cta_kicker')}
      </p>
      <h2 class="text-3xl md:text-4xl font-serif font-light text-forest-800 mb-5 leading-tight">
        {t('home.cta_title')}
      </h2>
      <p class="text-base text-forest-600 mb-8 leading-relaxed font-light">
        {t('home.cta_desc')}
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/quiz/jewelry" class="px-7 py-3 bg-forest-700 text-cream-50 text-sm tracking-wide rounded-sm hover:bg-forest-800 transition-all duration-500">
          {t('home.cta_quiz_jewelry')}
        </a>
        <a href="/quiz/incense" class="px-7 py-3 border border-forest-300 text-forest-700 text-sm tracking-wide rounded-sm hover:bg-cream-100 transition-all duration-500">
          {t('home.cta_quiz_incense')}
        </a>
      </div>
      <p class="mt-12 text-xs text-forest-400 italic font-light">
        {t('home.story_p2')}
      </p>
    </RevealOnScroll>
  </div>
</section>

<!-- Footer — minimal -->
<footer class="py-10 bg-forest-800 text-cream-100">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <p class="font-serif text-base mb-2 font-light">{t('common.site_name')}</p>
    <p class="text-xs text-cream-100/60 font-sans">
      {t('home.footer_rights')}
    </p>
  </div>
</footer>