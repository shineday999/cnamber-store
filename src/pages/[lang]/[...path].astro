---
import { defaultLocale, isLocale } from "../../i18n/config";

// Astro.params.path 是 string | string[] | undefined — 我們要 join
const lang = Astro.params.lang ?? "";
const pathParts = Astro.params.path ?? [];
const subPath =
  "/" + (Array.isArray(pathParts) ? pathParts.join("/") : pathParts);

// /zh-Hans/* 不該走這條路(default locale 不加 prefix)
if (!isLocale(lang) || lang === defaultLocale) {
  return Astro.rewrite("/404");
}

// 內部 rewrite 到根路徑,保留 URL 但 render 對應 page。
// Astro.rewrite 會 re-run middleware,此時 url.pathname 是新 path(沒 lang prefix),
// localeFromPath 找不到 /<lang>/ → fallback Accept-Language → en,所有 /[lang]/* 都錯。
// 解法:rewrite 前把原始 URL 存進 Astro.locals.originalPath,
// middleware 改讀 Astro.locals.originalPath ?? url.pathname 拿正確 locale。
(Astro.locals as { originalPath?: string }).originalPath = Astro.url.pathname;
return Astro.rewrite(subPath);
---
