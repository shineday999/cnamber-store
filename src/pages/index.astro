---
import Layout from "@layouts/Layout.astro";
import HomeContent from "@components/HomeContent.astro";
import { createT } from "../i18n/t";

const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);

const pageTitle = `${t("common.site_name")} — ${t("common.tagline")}`;
const pageDescription = t("home.hero_p3") ?? "";
---

<Layout title={pageTitle} description={pageDescription}>
  <HomeContent />
</Layout>
