---
import Layout from "@layouts/Layout.astro";
import RevealOnScroll from "@components/RevealOnScroll.astro";
import ContinueReading from "@components/ContinueReading.astro";
import { createT } from "../i18n/t";
import { defaultLocale, type Locale } from "../i18n/config";

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);
void locale;
---

<Layout
  title={`${t("vision.title")} — ${t("common.site_name")}`}
  description={t("vision.p1")}
>
  <article class="max-w-3xl mx-auto px-6 py-section">
    <RevealOnScroll>
      <header class="mb-16 text-center">
        <p
          class="text-[10px] uppercase tracking-[0.4em] text-forest-600 font-sans mb-4"
        >
          {t("vision.kicker")}
        </p>
        <h1
          class="text-display-sm md:text-display-md font-serif text-text-primary mb-4 leading-[1.08]"
        >
          {t("vision.title")}
        </h1>
        <p class="text-lg text-text-secondary italic max-w-xl mx-auto">
          {t("vision.subtitle")}
        </p>
      </header>
    </RevealOnScroll>

    <RevealOnScroll>
      <div
        class="space-y-6 text-text-secondary font-sans leading-relaxed text-base"
      >
        <p>{t("vision.p1")}</p>
        <p>{t("vision.p2")}</p>
        <p>{t("vision.p3")}</p>
        <blockquote class="my-12 py-6 border-y border-forest-100 text-center">
          <p
            class="text-xl md:text-2xl font-serif italic text-forest-700 leading-snug"
          >
            “{t("vision.p4")}”
          </p>
        </blockquote>
      </div>
    </RevealOnScroll>
  </article>
  <div class="max-w-5xl mx-auto px-6 pb-section">
    <ContinueReading
      heading={t("continue.heading")}
      links={[
        {
          href: "/craft",
          label: t("continue.vision_next_1_label"),
          desc: t("continue.vision_next_1_desc"),
        },
        {
          href: "/materials",
          label: t("continue.vision_next_2_label"),
          desc: t("continue.vision_next_2_desc"),
        },
        {
          href: "/amber",
          label: t("continue.vision_next_3_label"),
          desc: t("continue.vision_next_3_desc"),
        },
      ]}
    />
  </div>
</Layout>
