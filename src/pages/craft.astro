---
import Layout from '@layouts/Layout.astro';
import { createT } from '../i18n/t';

const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);
---

<Layout title={`${t('nav.craft')} — ${t('common.site_name')}`}>
  <article class="max-w-3xl mx-auto px-6 py-section">
    <header class="mb-12 text-center">
      <h1 class="text-display-sm md:text-display-md font-serif text-text-primary">
        {t('nav.craft')}
      </h1>
    </header>

    <div class="prose prose-lg max-w-none space-y-6 text-text-secondary font-sans leading-relaxed">
      <p>
        我們的手作工序從原石挑選開始。每一塊琥珀、每一根都需經過肉眼 + 強光透視,排除裂紋、雜質與人工優化痕跡。
      </p>
      <p>
        切割以保留最大透光性為原則 — 不追求切出最多的成品,而是讓每一刀都對得起時間的重量。
        研磨分粗磨、細磨、拋光三階段,中間需反覆以放大鏡觀察紋理走向,避免磨掉應保留的細節。
      </p>
      <p>
        鑽孔採手動轉速控制,避免高速產生熱裂紋。串珠之間的打結採中國結古法,受力均勻且不易鬆脫。
      </p>
      <p>
        香品的調配遵循傳統香方,以沉香、檀香為主調,佐以丁香、龍腦、甘草等輔料。配比不對,香氣便失去層次。
      </p>
      <p>
        我們相信:慢,是對自然的尊重。
      </p>
    </div>
  </article>
</Layout>