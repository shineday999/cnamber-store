---
import Layout from "@layouts/Layout.astro";
import RevealOnScroll from "@components/RevealOnScroll.astro";
import { createT } from "../i18n/t";
import { defaultLocale, type Locale } from "../i18n/config";

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);
void locale;
---

<Layout
  title={`${t("incense.title")} — ${t("common.site_name")}`}
  description={t("incense.p1")}
>
  <article class="max-w-4xl mx-auto px-6 py-section">
    <RevealOnScroll>
      <header class="mb-16 text-center">
        <p
          class="text-[10px] uppercase tracking-[0.4em] text-forest-600 font-sans mb-4"
        >
          {t("incense.kicker")}
        </p>
        <h1
          class="text-display-sm md:text-display-md font-serif text-text-primary mb-4 leading-[1.08]"
        >
          {t("incense.title")}
        </h1>
        <p class="text-lg text-text-secondary italic max-w-xl mx-auto">
          {t("incense.subtitle")}
        </p>
      </header>
    </RevealOnScroll>

    <RevealOnScroll>
      <div
        class="space-y-6 text-text-secondary font-sans leading-relaxed text-base max-w-3xl mx-auto"
      >
        <p>{t("incense.p1")}</p>
        <p>{t("incense.p2")}</p>
        <p>{t("incense.p3")}</p>
      </div>
    </RevealOnScroll>

    <RevealOnScroll>
      <div class="text-center mt-12">
        <a
          href="/products?cat=incense"
          class="inline-flex items-center gap-2 text-forest-700 hover:text-forest-800 border-b border-forest-300 pb-1 font-sans tracking-wide link-underline"
        >
          {t("incense.cta")}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </RevealOnScroll>
  </article>
</Layout>
