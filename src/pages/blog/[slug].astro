---
import Layout from '@layouts/Layout.astro';
import { createT } from '../../i18n/t';
import { defaultLocale, type Locale } from '../../i18n/config';

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);

const slug = Astro.params.slug ?? '';
const env = Astro.locals.runtime?.env;

const post = env?.DB
  ? await env.DB
      .prepare(
        `SELECT p.*, pt.locale, pt.title, pt.excerpt, pt.body_markdown
         FROM posts p
         LEFT JOIN post_translations pt ON pt.post_id = p.id AND pt.locale = ?
         WHERE p.slug = ? AND p.status = 'published'`,
      )
      .bind(locale, slug)
      .first<{
        id: string;
        slug: string;
        category: string | null;
        cover_image_url: string | null;
        published_at: number | null;
        title: string | null;
        excerpt: string | null;
        body_markdown: string | null;
      }>()
  : null;

if (!post) {
  return new Response('Post not found', { status: 404 });
}

// 簡易 markdown 渲染(粗體 + 段落)
function renderMarkdown(md: string): string {
  return md
    .split(/\n\n+/)
    .map((para) => {
      const escaped = para
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
      const formatted = escaped
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.+?)\*/g, '<em>$1</em>')
        .replace(/^##\s+(.+)$/gm, '<h2 class="font-serif text-2xl mt-8 mb-3">$1</h2>')
        .replace(/^#\s+(.+)$/gm, '<h1 class="font-serif text-display-sm mt-8 mb-4">$1</h1>')
        .replace(/\n/g, '<br>');
      return formatted.startsWith('<h') ? formatted : `<p class="mb-4 leading-relaxed">${formatted}</p>`;
    })
    .join('');
}

const title = post.title ?? post.slug;
void locale;
---

<Layout title={`${title} — ${t('common.site_name')}`} description={post.excerpt ?? ''}>
  <article class="max-w-3xl mx-auto px-6 py-section">
    <a href="/blog" class="text-sm text-text-secondary hover:text-text-primary inline-block mb-6">← Blog</a>

    {post.category && (
      <div class="text-xs uppercase tracking-[0.3em] text-accent-700 mb-3 font-sans">{post.category}</div>
    )}
    <h1 class="text-display-sm md:text-display-md font-serif text-text-primary mb-3">{title}</h1>
    {post.published_at && (
      <div class="text-sm text-text-muted mb-6">{new Date(post.published_at * 1000).toISOString().slice(0, 10)}</div>
    )}

    {post.cover_image_url && (
      <img src={post.cover_image_url} alt={title} class="w-full aspect-video object-cover rounded-card mb-8" />
    )}

    {post.excerpt && (
      <p class="text-lg text-text-secondary italic mb-8 leading-relaxed border-l-4 border-accent-300 pl-4">{post.excerpt}</p>
    )}

    <div class="prose prose-lg max-w-none text-text-primary font-sans" set:html={renderMarkdown(post.body_markdown ?? '')} />

    <div class="mt-12 pt-6 border-t border-text-muted/20 text-sm">
      <a href="/blog" class="text-text-secondary hover:text-text-primary">← Back to Blog</a>
    </div>
  </article>
</Layout>