---
import Layout from '@layouts/Layout.astro';
import { createT } from '../i18n/t';
import { defaultLocale, type Locale } from '../i18n/config';

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);
void locale;
---

<Layout title={`${t('story.title')} — ${t('common.site_name')}`} description={t('story.p1')}>
  <article class="max-w-3xl mx-auto px-6 py-section">
    <header class="mb-12 text-center">
      <p class="text-sm uppercase tracking-[0.3em] text-accent-700 font-sans mb-3">About</p>
      <h1 class="text-display-sm md:text-display-md font-serif text-text-primary mb-3">
        {t('story.title')}
      </h1>
      <p class="text-lg text-text-secondary italic">{t('story.subtitle')}</p>
    </header>

    <div class="prose prose-lg max-w-none space-y-6 text-text-secondary font-sans leading-relaxed">
      <p>{t('story.p1')}</p>
      <p>{t('story.p2')}</p>
      <p>{t('story.p3')}</p>
    </div>
  </article>
</Layout>