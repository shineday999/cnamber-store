---
import Layout from "@layouts/Layout.astro";
import Card from "@components/Card.astro";
import { createT } from "../../i18n/t";
import { defaultLocale, localizedPath, type Locale } from "../../i18n/config";

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);

const pageTitle = `${t("nav.quiz")} — ${t("common.site_name")}`;
void locale;
---

<Layout title={pageTitle} description={t("quiz.intro")}>
  <div data-qz-page class="max-w-4xl mx-auto px-6 py-section">
    <header data-qz-header class="text-center mb-12">
      <p
        class="text-sm uppercase tracking-[0.3em] text-accent-700 font-sans mb-3"
      >
        {t("quiz.kicker")}
      </p>
      <h1
        class="text-display-sm md:text-display-md font-serif text-text-primary mb-4"
      >
        {t("nav.quiz")}
      </h1>
      <p class="text-lg text-text-secondary max-w-2xl mx-auto">
        {t("quiz.intro")}
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <Card
        href={localizedPath(locale, "/quiz/jewelry")}
        class="qz-card hover:border-accent-500 transition-colors p-8"
      >
        <div data-qz-icon class="text-accent-700 mb-3">
          <svg
            class="w-12 h-12"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M12 6.5a2 2 0 100-4 2 2 0 000 4zM12 8v8m-3 0h6m-6 4h6"></path>
          </svg>
        </div>
        <div data-qz-body>
          <h2 class="font-serif text-2xl mb-2">{t("quiz.jewelry.title")}</h2>
          <p class="text-text-secondary mb-4">{t("quiz.jewelry.desc")}</p>
          <div data-qz-foot>
            <p data-qz-meta>{t("home.cta_meta")}</p>
            <p class="text-sm text-accent-700 font-medium">
              <span data-qz-lead>→ </span>{t("quiz.start")} →
            </p>
          </div>
        </div>
      </Card>

      <Card
        href={localizedPath(locale, "/quiz/incense")}
        class="qz-card hover:border-accent-500 transition-colors p-8"
      >
        <div data-qz-icon class="text-accent-700 mb-3">
          <svg
            class="w-12 h-12"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M12 3v3m0 0c-2 0-3 2-3 4 0 4 3 6 3 11 0-5 3-7 3-11 0-2-1-4-3-4z"
            ></path>
          </svg>
        </div>
        <div data-qz-body>
          <h2 class="font-serif text-2xl mb-2">{t("quiz.incense.title")}</h2>
          <p class="text-text-secondary mb-4">{t("quiz.incense.desc")}</p>
          <div data-qz-foot>
            <p data-qz-meta>{t("home.cta_meta")}</p>
            <p class="text-sm text-accent-700 font-medium">
              <span data-qz-lead>→ </span>{t("quiz.start")} →
            </p>
          </div>
        </div>
      </Card>
    </div>
  </div>
</Layout>
