---
import Layout from '@layouts/Layout.astro';
import Button from '@components/Button.astro';
import { createT } from '../i18n/t';
import { defaultLocale, type Locale } from '../i18n/config';
import { readCart } from '../lib/cart';

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);

const cookieHeader = Astro.request.headers.get('cookie');
const items = readCart(cookieHeader);

const env = Astro.locals.runtime?.env;
const enriched = env?.DB && items.length > 0
  ? await env.DB.prepare(
      `SELECT p.slug, pt.name, pv.sku, pv.price_base, MIN(pp.amount) AS min_amount, pp.currency
       FROM product_variants pv
       JOIN products p ON p.id = pv.product_id
       LEFT JOIN product_translations pt ON pt.product_id = p.id AND pt.locale = ?
       LEFT JOIN product_prices pp ON pp.variant_id = pv.id
       WHERE p.slug IN (${items.map(() => '?').join(',')})
       GROUP BY p.slug, pv.sku`,
    )
    .bind(locale, ...items.map((i) => i.slug))
    .all()
  : { results: [] as Array<Record<string, unknown>> };

const subtotal = enriched.results.reduce((sum, row) => {
  const qty = items.find((i) => i.slug === row.slug)?.qty ?? 1;
  return sum + ((row.min_amount as number) ?? 0) * qty;
}, 0);
const currency = (enriched.results[0]?.currency as string) ?? 'USD';

void locale;
void t;
---

<Layout title={`Cart — ${t('common.site_name')}`}>
  <div class="max-w-4xl mx-auto px-6 py-section">
    <h1 class="text-display-sm font-serif text-text-primary mb-8">{t('cart.title')}</h1>

    {items.length === 0 ? (
      <div class="text-center py-12 text-text-muted">
        <p class="text-lg mb-4">{t('cart.empty')}</p>
        <Button href="/products">{t('common.view_more')}</Button>
      </div>
    ) : (
      <div class="space-y-4">
        {enriched.results.map((row) => (
          <div class="bg-bg-card border border-text-muted/20 rounded-card p-4 flex items-center justify-between">
            <div>
              <div class="font-medium">{(row.name as string) ?? (row.slug as string)}</div>
              <div class="text-xs font-mono text-text-muted">{row.sku as string}</div>
            </div>
            <div class="text-right">
              <div class="font-mono">
                {(row.min_amount as number) / 100} {row.currency as string}
              </div>
              <form method="POST" action="/api/cart/remove" class="inline">
                <input type="hidden" name="slug" value={row.slug as string} />
                <input type="hidden" name="sku" value={(row.sku as string) ?? ''} />
                <button class="text-xs text-error hover:underline">{t('cart.remove')}</button>
              </form>
            </div>
          </div>
        ))}

        <div class="border-t border-t border-text-muted/20 pt-4 mt-4 flex justify-between items-center">
          <div class="text-lg font-serif">{(t('cart.subtotal') ?? 'Subtotal')}:</div>
          <div class="text-2xl font-mono font-medium">{(subtotal / 100).toFixed(2)} {currency}</div>
        </div>

        <Button href="/checkout" variant="primary" size="lg" class="w-full">
          {t('cart.checkout') ?? 'Proceed to checkout'}
        </Button>
      </div>
    )}
  </div>
</Layout>