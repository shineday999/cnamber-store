---
import Layout from "@layouts/Layout.astro";
import Button from "@components/Button.astro";
import { createT } from "../i18n/t";
import { defaultLocale, type Locale } from "../i18n/config";
import { readCart } from "../lib/cart";
import { formatPrice } from "../lib/format";

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);

const cookieHeader = Astro.request.headers.get("cookie");
const items = readCart(cookieHeader);

const env = Astro.locals.runtime?.env;

// 修正 SQL 聚合:一個 product 一個 row,只抓 USD 價(轉 CNY 顯示),
// GROUP BY p.slug 防 product_variants 多 variant 拆多 row。
// 修正前:`MIN(pp.amount) AS min_amount` + `pp.currency` 不在 GROUP BY
// → 跨 currency 比 MIN 沒意義 + currency 隨機,total 算錯。
const enriched =
  env?.DB && items.length > 0
    ? await env.DB.prepare(
        `SELECT p.slug, pt.name, MIN(pp.amount) AS amount, pp.currency
       FROM products p
       LEFT JOIN product_translations pt ON pt.product_id = p.id AND pt.locale = ?
       LEFT JOIN product_variants pv ON pv.product_id = p.id
       LEFT JOIN product_prices pp ON pp.variant_id = pv.id AND pp.currency = 'USD'
       WHERE p.slug IN (${items.map(() => "?").join(",")})
       GROUP BY p.slug`,
      )
        .bind(locale, ...items.map((i) => i.slug))
        .all()
    : { results: [] as Array<Record<string, unknown>> };

// 修正 qty lookup:用 Map 而不是 Array.find 取第一個匹配,
// 多筆同 slug 不同 sku 才不會 qty 漏算。
const qtyMap = new Map<string, number>();
for (const it of items) {
  qtyMap.set(it.slug, (qtyMap.get(it.slug) ?? 0) + it.qty);
}

const subtotalCents = enriched.results.reduce((sum, row) => {
  const qty = qtyMap.get(row.slug as string) ?? 1;
  return sum + ((row.amount as number) ?? 0) * qty;
}, 0);

void locale;
void t;
---

<Layout title={`Cart — ${t("common.site_name")}`}>
  <div class="max-w-4xl mx-auto px-6 py-section">
    <h1 class="text-display-sm font-serif text-text-primary mb-8">
      {t("cart.title")}
    </h1>

    {
      items.length === 0 ? (
        <div class="text-center py-12 text-text-muted">
          <p class="text-lg mb-4">{t("cart.empty")}</p>
          <Button href="/products">{t("common.view_more")}</Button>
        </div>
      ) : (
        <div class="space-y-4">
          {enriched.results.map((row) => {
            const qty = qtyMap.get(row.slug as string) ?? 1;
            const lineCents = (row.amount as number) ?? 0;
            return (
              <div class="bg-bg-card border border-text-muted/20 rounded-card p-4 flex items-center justify-between">
                <div>
                  <div class="font-medium">
                    {(row.name as string) ?? (row.slug as string)}
                  </div>
                  <div class="text-xs text-text-muted">qty {qty}</div>
                </div>
                <div class="text-right">
                  <div class="font-mono">
                    {formatPrice(lineCents, "USD", locale)}
                  </div>
                  <div class="flex gap-2 justify-end mt-1">
                    <form
                      method="POST"
                      action="/api/cart/remove"
                      class="inline"
                    >
                      <input
                        type="hidden"
                        name="slug"
                        value={row.slug as string}
                      />
                      <button class="text-xs text-error hover:underline">
                        {t("cart.remove")}
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            );
          })}

          <div class="border-t border-text-muted/20 pt-4 mt-4 flex justify-between items-center">
            <div class="text-lg font-serif">
              {t("cart.subtotal") ?? "Subtotal"}:
            </div>
            <div class="text-2xl font-mono font-medium">
              {formatPrice(subtotalCents, "USD", locale)}
            </div>
          </div>

          <Button href="/checkout" variant="primary" size="lg" class="w-full">
            {t("cart.checkout") ?? "Proceed to checkout"}
          </Button>

          <form method="POST" action="/api/cart/clear" class="text-center">
            <button class="text-xs text-text-muted hover:text-error hover:underline">
              {t("cart.clear") ?? "Clear cart"}
            </button>
          </form>
        </div>
      )
    }
  </div>
</Layout>
