---
// src/pages/[...notFound].astro — top-level catch-all for unknown paths.
//
// Why this exists: Astro 4 + @astrojs/cloudflare only fires src/pages/404.astro
// for routes matching an existing folder prefix (/products/*, /admin/*, etc.).
// Top-level misses like /zzz or /anything-typoed fall through to a CF Pages
// 302→/ default. This catch-all ensures ANY path Astro can't route renders
// our on-brand 404 page with proper 404 status.
import NotFound from "./404.astro";

Astro.response.status = 404;
---

<NotFound />
