---
// /products/[slug] — 2 區塊:大圖 + info。Editorial still-life feel.
// 不要長篇 story / reviews / related — 留白呼吸感最重要。
import Layout from "@layouts/Layout.astro";
import { createT } from "../../i18n/t";
import { defaultLocale, type Locale } from "../../i18n/config";
import { formatPrice } from "@lib/format";

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);

const slug = Astro.params.slug ?? "";
const env = Astro.locals.runtime?.env;

interface Product {
  id: string;
  slug: string;
  category: string;
  status: string;
}

interface Translation {
  name: string;
  description: string;
  short_description: string | null;
  story: string | null;
}

interface Variant {
  id: string;
  sku: string;
  attributes: string;
  stock: number;
  price_base: string;
}

interface Price {
  currency: string;
  amount: number;
}

const product = env?.DB
  ? await env.DB.prepare(
      "SELECT id, slug, category, status FROM products WHERE slug = ? AND status = ?",
    )
      .bind(slug, "active")
      .first<Product>()
  : null;

if (!product) {
  return new Response("Product not found", { status: 404 });
}

const translation = env?.DB
  ? await env.DB.prepare(
      "SELECT name, description, short_description, story FROM product_translations WHERE product_id = ? AND locale = ?",
    )
      .bind(product.id, locale)
      .first<Translation>()
  : null;

const fallback = env?.DB
  ? await env.DB.prepare(
      "SELECT name, description, short_description, story FROM product_translations WHERE product_id = ? AND locale = ?",
    )
      .bind(product.id, "en")
      .first<Translation>()
  : null;

const tr = translation ??
  fallback ?? {
    name: product.slug,
    description: "",
    short_description: null,
    story: null,
  };

const variants = env?.DB
  ? await env.DB.prepare(
      "SELECT id, sku, attributes, stock, price_base FROM product_variants WHERE product_id = ?",
    )
      .bind(product.id)
      .all<Variant>()
  : { results: [] };

const prices = env?.DB
  ? await env.DB.prepare(
      "SELECT currency, amount FROM product_prices WHERE variant_id IN (SELECT id FROM product_variants WHERE product_id = ?) AND currency = ?",
    )
      .bind(product.id, "USD")
      .all<Price>()
  : { results: [] };

const firstImageUrl = variants.results[0]?.id
  ? env?.DB
    ? (
        await env.DB.prepare(
          "SELECT image_urls FROM product_variants WHERE id = ?",
        )
          .bind(variants.results[0].id)
          .first<{ image_urls: string }>()
      )?.image_urls
    : null
  : null;

let heroImage = "";
if (firstImageUrl) {
  try {
    const urls = JSON.parse(firstImageUrl) as string[];
    heroImage = urls[0] ?? "";
  } catch {}
}

const priceMap = new Map(
  prices.results.map((p) => [p.currency, p.amount / 100]),
);
const usdPrice = priceMap.get("USD");

const pageTitle = `${tr.name} — ${t("common.site_name")}`;
void locale;
---

<Layout
  title={pageTitle}
  description={tr.short_description ?? tr.description.slice(0, 160)}
>
  <!-- 1. Hero image — full-width 80vh cinematic still-life -->
  <section
    class="relative h-[60vh] min-h-[420px] overflow-hidden bg-forest-800"
  >
    {
      heroImage ? (
        <img
          decoding="sync"
          src={heroImage}
          alt={tr.name}
          class="w-full h-full object-cover cinematic"
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center bg-forest-100">
          <span class="text-forest-700 font-serif text-6xl font-light">
            No image
          </span>
        </div>
      )
    }
    <div
      class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-forest-900/40"
    >
    </div>

    <div class="absolute bottom-8 left-0 right-0 px-6 max-w-6xl mx-auto">
      <a
        href="/products"
        class="inline-block text-xs uppercase tracking-[0.4em] text-cream-100/80 hover:text-cream-50 transition-colors font-sans border-b border-cream-100/30 pb-0.5"
      >
        ← Back to all
      </a>
    </div>
  </section>

  <!-- 2. Asymmetric 8/4 split: large image left + compact info right -->
  <section class="py-20 relative">
    <div class="relative max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-12 gap-8 md:gap-12">
        <!-- 8 cols: secondary image (still-life detail) -->
        <div class="col-span-12 md:col-span-8">
          {
            heroImage && (
              <div class="aspect-[4/3] overflow-hidden bg-forest-100">
                <img
                  decoding="async"
                  src={heroImage.replace("800/800", "1200/900")}
                  alt={`${tr.name} detail`}
                  class="w-full h-full object-cover cinematic transition-transform duration-[1400ms] ease-out hover:scale-[1.04]"
                  loading="lazy"
                />
              </div>
            )
          }
        </div>

        <!-- 4 cols: info column -->
        <div
          class="col-span-12 md:col-span-4 md:sticky md:top-12 md:self-start"
        >
          <p
            class="text-[10px] uppercase tracking-[0.4em] text-forest-600 mb-3 font-sans"
          >
            {product.category === "jewelry" ? t("nav.amber") : t("nav.incense")}
          </p>
          <h1
            class="text-3xl md:text-4xl font-serif font-light text-forest-800 mb-4 leading-tight"
          >
            {tr.name}
          </h1>

          {
            tr.short_description && (
              <p class="text-forest-600 leading-relaxed mb-6 text-sm font-light">
                {tr.short_description}
              </p>
            )
          }

          {
            usdPrice !== undefined && (
              <p class="font-serif text-2xl text-forest-800 mb-8">
                <span class="text-forest-600 text-sm font-sans mr-2">from</span>
                {formatPrice(Math.round(usdPrice * 100), "USD", locale)}
              </p>
            )
          }

          {
            variants.results.length > 0 && (
              <div class="mb-8">
                <p class="text-xs uppercase tracking-[0.4em] text-forest-600 mb-3 font-sans">
                  {t("common.options")}
                </p>
                <ul class="space-y-1.5">
                  {variants.results.slice(0, 3).map((v) => (
                    <li class="text-sm font-sans text-forest-700 flex justify-between border-b border-forest-100 pb-1">
                      <span class="font-mono text-xs">{v.sku}</span>
                      <span class="text-forest-600 text-xs">
                        stock {v.stock}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <form method="POST" action="/api/cart/add" class="space-y-3">
            <input type="hidden" name="slug" value={product.slug} />
            <button
              type="submit"
              class="w-full px-7 py-3.5 bg-forest-700 text-cream-50 text-sm tracking-wide rounded-sm hover:bg-forest-800 transition-all duration-500"
            >
              {t("common.reserve")} →
            </button>
            <a
              href="/contact"
              class="block text-center text-xs text-forest-700 hover:text-forest-700 transition-colors tracking-wide font-sans border-b border-forest-200 pb-0.5"
            >
              {t("nav.contact")} →
            </a>
          </form>

          {
            tr.story && (
              <p class="mt-10 text-sm text-forest-700 italic leading-relaxed font-light border-l-2 border-terra-300 pl-4">
                {tr.story}
              </p>
            )
          }
        </div>
      </div>
    </div>
  </section>
</Layout>
