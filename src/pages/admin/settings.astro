---
// /admin/settings — Wave 28.7d 編輯網站名稱 / 主題 / 次主題 (3 keys × 4 locales)
// 純文字標籤,管理員自由填寫。前台 layout 用 current locale,缺值 fallback zh-Hans。
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createT } from "../../i18n/t";
import zhHansMessages from "../../i18n/messages/zh-Hans.json";

const env = Astro.locals.runtime?.env;
const messages = zhHansMessages as Record<string, unknown>;
const t = createT(messages);
const admin = Astro.locals.admin;

interface SettingRow {
  key: string;
  locale: string;
  value: string;
}

const rows = env?.DB
  ? await env.DB.prepare(
      "SELECT key, locale, value FROM site_settings",
    ).all<SettingRow>()
  : { results: [] as SettingRow[] };

// 3 keys × 4 locales grid:valueMap[key][locale] = current text
const valueMap: Record<string, Record<string, string>> = {
  site_name: {},
  hero_subtitle: {},
  theme: {},
  sub_theme: {},
};
for (const r of rows.results ?? []) {
  if (r.key in valueMap) valueMap[r.key][r.locale] = r.value;
}

const LOCALES = [
  { code: "zh-Hans", label: "中文 (简体)" },
  { code: "en", label: "English" },
  { code: "ms-MY", label: "Bahasa Melayu" },
  { code: "id-ID", label: "Bahasa Indonesia" },
] as const;

const KEY_SECTIONS = [
  {
    key: "site_name",
    label: t("admin.settings.section.site_name"),
    hint: t("admin.settings.hint.site_name"),
  },
  {
    key: "hero_subtitle",
    label: t("admin.settings.section.hero_subtitle"),
    hint: t("admin.settings.hint.hero_subtitle"),
  },
  {
    key: "theme",
    label: t("admin.settings.section.theme"),
    hint: t("admin.settings.hint.theme"),
  },
  {
    key: "sub_theme",
    label: t("admin.settings.section.sub_theme"),
    hint: t("admin.settings.hint.sub_theme"),
  },
];

const saved = Astro.url.searchParams.get("saved") === "1";

// Wave 29: 橫幅併入設定,直接從 D1 抓 hero_banners list
const banners = env?.DB
  ? await env.DB.prepare(
      "SELECT id, image_url, alt_text, sort_order, active FROM hero_banners ORDER BY sort_order ASC, created_at DESC",
    ).all<{
      id: string;
      image_url: string;
      alt_text: string | null;
      sort_order: number;
      active: number;
    }>()
  : {
      results: [] as Array<{
        id: string;
        image_url: string;
        alt_text: string | null;
        sort_order: number;
        active: number;
      }>,
    };

void admin;
---

<AdminLayout title={t("admin.settings.title")} active="settings">
  <p class="text-text-secondary mb-6">{t("admin.settings.subtitle")}</p>

  {
    saved && (
      <div class="mb-6 bg-success/10 border border-success/30 text-success px-4 py-3 rounded text-sm">
        {t("admin.settings.saved")}
      </div>
    )
  }

  <form method="POST" action="/api/admin/settings" class="space-y-8">
    {
      KEY_SECTIONS.map(({ key, label, hint }) => (
        <section class="bg-bg-card border border-text-muted/20 rounded-card p-6">
          <h2 class="text-lg font-serif mb-1">{label}</h2>
          <p class="text-xs text-text-muted mb-4">{hint}</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {LOCALES.map(({ code, label: localeLabel }) => (
              <div>
                <label
                  class="block text-sm font-medium mb-1"
                  for={`${key}__${code}`}
                >
                  {localeLabel}
                  <span class="text-text-muted text-xs ml-1">({code})</span>
                </label>
                <input
                  id={`${key}__${code}`}
                  name={`${key}__${code}`}
                  type="text"
                  value={valueMap[key]?.[code] ?? ""}
                  class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base font-mono text-sm"
                />
              </div>
            ))}
          </div>
        </section>
      ))
    }

    <div class="flex items-center gap-3">
      <button
        type="submit"
        class="px-6 py-3 bg-forest-700 text-bg-base rounded-md font-medium hover:bg-forest-900 transition-colors"
      >
        {t("admin.common.save")}
      </button>
      <a
        href="/admin"
        class="text-text-muted hover:text-text-primary text-sm underline"
      >
        {t("admin.common.back")}
      </a>
    </div>
  </form>

  <!-- Wave 29: 橫幅管理併入設定頁 -->
  <section
    id="banners"
    class="mt-10 bg-bg-card border border-text-muted/20 rounded-card p-6"
  >
    <h2 class="text-lg font-serif mb-1">{t("admin.banners.title")}</h2>
    <p class="text-xs text-text-muted mb-4">
      {t("admin.banners.dimension_label")} 1920×1080
    </p>

    <form
      method="POST"
      action="/api/admin/banners"
      enctype="multipart/form-data"
      class="space-y-3 max-w-2xl mb-6"
    >
      <div>
        <label class="block text-sm font-medium mb-1" for="image"
          >{t("admin.banners.upload_image")}</label
        >
        <input
          id="image"
          name="image"
          type="file"
          accept="image/jpeg,image/png,image/webp,image/gif"
          required
          class="w-full text-sm file:mr-3 file:py-2 file:px-4 file:border-0 file:bg-forest-700 file:text-bg-base file:rounded file:cursor-pointer"
        />
      </div>
      <div class="grid grid-cols-3 gap-3">
        <div class="col-span-2">
          <label class="block text-sm font-medium mb-1" for="alt_text"
            >{t("admin.banners.alt_text")}</label
          >
          <input
            id="alt_text"
            name="alt_text"
            type="text"
            class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" for="sort_order"
            >{t("admin.banners.sort_order")}</label
          >
          <input
            id="sort_order"
            name="sort_order"
            type="number"
            value="0"
            class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
          />
        </div>
      </div>
      <label class="inline-flex items-center gap-2 text-sm">
        <input type="checkbox" name="active" value="1" checked />
        <span>{t("admin.banners.active")}</span>
      </label>
      <div>
        <button
          type="submit"
          class="px-4 py-2 bg-forest-700 text-bg-base rounded-md hover:bg-forest-900"
        >
          {t("admin.banners.upload")}
        </button>
      </div>
    </form>

    {
      banners.results.length === 0 ? (
        <p class="text-text-muted text-sm">{t("admin.banners.empty")}</p>
      ) : (
        <table class="w-full text-sm">
          <thead class="bg-forest-100 text-text-primary">
            <tr>
              <th class="text-left px-3 py-2 font-medium">
                {t("admin.banners.preview")}
              </th>
              <th class="text-left px-3 py-2 font-medium">
                {t("admin.banners.alt_text")}
              </th>
              <th class="text-left px-3 py-2 font-medium">
                {t("admin.banners.sort_order")}
              </th>
              <th class="text-left px-3 py-2 font-medium">
                {t("admin.banners.active")}
              </th>
              <th class="text-right px-3 py-2 font-medium">
                {t("admin.banners.delete")}
              </th>
            </tr>
          </thead>
          <tbody>
            {banners.results.map((b) => (
              <tr class="border-t border-text-muted/10">
                <td class="px-3 py-2">
                  <img
                    loading="lazy"
                    decoding="async"
                    src={b.image_url}
                    alt={b.alt_text ?? ""}
                    class="w-32 h-18 object-cover rounded border border-text-muted/20"
                  />
                </td>
                <td class="px-3 py-2">{b.alt_text ?? "—"}</td>
                <td class="px-3 py-2 font-mono text-xs">{b.sort_order}</td>
                <td class="px-3 py-2">
                  <form
                    method="POST"
                    action={`/api/admin/banners/${b.id}`}
                    class="inline"
                  >
                    <input type="hidden" name="_method" value="PATCH" />
                    <input
                      type="hidden"
                      name="alt_text"
                      value={b.alt_text ?? ""}
                    />
                    <input
                      type="hidden"
                      name="sort_order"
                      value={b.sort_order}
                    />
                    <input
                      type="hidden"
                      name="active"
                      value={b.active === 1 ? "0" : "1"}
                    />
                    <button
                      type="submit"
                      class="text-accent-700 hover:underline"
                    >
                      {b.active === 1
                        ? t("admin.banners.deactivate")
                        : t("admin.banners.activate")}
                    </button>
                  </form>
                </td>
                <td class="px-3 py-2 text-right">
                  <button
                    type="button"
                    class="text-error hover:underline"
                    data-banner-id={b.id}
                  >
                    {t("admin.banners.delete")}
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </section>

  <script is:inline>
    (function () {
      var confirmText = "确定删除该横幅？图片会从 R2 一并移除";
      document.querySelectorAll("[data-banner-id]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var id = btn.getAttribute("data-banner-id");
          if (!id) return;
          if (!window.confirm(confirmText)) return;
          var f = document.createElement("form");
          f.method = "POST";
          f.action = "/api/admin/banners/" + id;
          var m = document.createElement("input");
          m.name = "_method";
          m.value = "DELETE";
          f.appendChild(m);
          document.body.appendChild(f);
          f.submit();
        });
      });
    })();
  </script>
</AdminLayout>
