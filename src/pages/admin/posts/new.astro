---
import AdminLayout from "../../../layouts/AdminLayout.astro";

const LOCALES = ["zh-Hans", "en", "ms-MY", "id-ID"] as const;
---

<AdminLayout title="New Post" active="blog">
  <p class="text-text-secondary mb-6">
    Create a new blog post. Title and body required for zh-Hans (default).
  </p>

  <form method="POST" action="/api/admin/posts" class="space-y-6">
    <div
      class="bg-bg-card border border-text-muted/20 rounded-card p-6 space-y-4 max-w-2xl"
    >
      <div>
        <label class="block text-sm font-medium mb-1" for="slug">Slug</label>
        <input
          id="slug"
          name="slug"
          required
          placeholder="baltic-amber-origin"
          class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base font-mono"
        />
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium mb-1" for="category"
            >Category</label
          >
          <select
            id="category"
            name="category"
            class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
          >
            <option value="">—</option>
            <option value="material">material</option>
            <option value="craft">craft</option>
            <option value="style">style</option>
            <option value="culture">culture</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" for="status"
            >Status</label
          >
          <select
            id="status"
            name="status"
            class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
          >
            <option value="draft">draft</option>
            <option value="published">published</option>
          </select>
        </div>
      </div>
    </div>

    <div class="space-y-4 max-w-3xl">
      {
        LOCALES.map((loc) => (
          <fieldset class="bg-bg-card border border-text-muted/20 rounded-card p-5 space-y-3">
            <legend class="font-serif text-lg px-2">
              {loc}
              {loc === "zh-Hans" ? " (required)" : ""}
            </legend>
            <input
              type="hidden"
              name={`translations[${loc}][locale]`}
              value={loc}
            />
            <div>
              <label
                class="block text-sm font-medium mb-1"
                for={`title-${loc}`}
              >
                Title
              </label>
              <input
                id={`title-${loc}`}
                name={`translations[${loc}][title]`}
                required={loc === "zh-Hans"}
                class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
              />
            </div>
            <div>
              <label
                class="block text-sm font-medium mb-1"
                for={`excerpt-${loc}`}
              >
                Excerpt
              </label>
              <textarea
                id={`excerpt-${loc}`}
                name={`translations[${loc}][excerpt]`}
                rows="2"
                class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
              />
            </div>
            <div>
              <label class="block text-sm font-medium mb-1" for={`body-${loc}`}>
                Body (Markdown){loc === "zh-Hans" ? " *" : ""}
              </label>
              <textarea
                id={`body-${loc}`}
                name={`translations[${loc}][body_markdown]`}
                rows="10"
                required={loc === "zh-Hans"}
                class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base font-mono text-sm"
              />
            </div>
          </fieldset>
        ))
      }
    </div>

    <div class="flex gap-2">
      <button
        type="submit"
        class="px-4 py-2 bg-forest-700 text-bg-base rounded-md hover:bg-forest-900"
        >Create Draft</button
      >
      <a
        href="/admin/posts"
        class="px-4 py-2 border border-text-muted/30 rounded-md hover:bg-bg-base"
        >Cancel</a
      >
    </div>
  </form>
</AdminLayout>
