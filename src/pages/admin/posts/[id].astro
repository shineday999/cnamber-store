---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Tabs from "../../../components/Tabs.astro";
import { createT, tEnum } from "../../../i18n/t";
import { defaultLocale, type Locale } from "../../../i18n/config";
import zhHansMessages from "../../../i18n/messages/zh-Hans.json";

const id = Astro.params.id;
const env = Astro.locals.runtime?.env;
const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = zhHansMessages as Record<string, unknown>;
const t = createT(messages);
void locale;

const post = env?.DB
  ? await env.DB.prepare("SELECT * FROM posts WHERE id = ?").bind(id).first<{
      id: string;
      slug: string;
      status: string;
      category: string | null;
      cover_image_url: string | null;
      published_at: number | null;
      faq: string | null;
    }>()
  : null;

const translations = env?.DB
  ? await env.DB.prepare("SELECT * FROM post_translations WHERE post_id = ?")
      .bind(id)
      .all<{
        locale: string;
        title: string;
        excerpt: string | null;
        body_markdown: string;
      }>()
  : { results: [] };

const LOCALES = ["zh-Hans", "en", "ms-MY", "id-ID"] as const;
const trByLocale = (l: string) =>
  translations.results.find((t) => t.locale === l);

if (!post) {
  return Astro.redirect("/admin/posts");
}
---

<AdminLayout
  title={`${t("admin.posts_detail.title_prefix")}${post.slug}`}
  active="blog"
>
  <Tabs
    tabs={[
      { id: "core", label: t("admin.posts_detail.tab_core") },
      { id: "translations", label: t("admin.posts_detail.tab_translations") },
      { id: "faq", label: t("admin.posts_detail.tab_faq") },
    ]}
    paramName="tab"
  >
    <div slot="core">
      <div
        class="bg-bg-card border border-text-muted/20 rounded-card p-6 mb-6 max-w-2xl"
      >
        <form method="POST" action={`/api/admin/posts/${id}`} class="space-y-4">
          <div class="grid grid-cols-3 gap-4">
            <div>
              <label class="block text-sm font-medium mb-1" for="category"
                >{t("admin.posts_detail.label_category")}</label
              >
              <select
                id="category"
                name="category"
                class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
              >
                {
                  ["material", "craft", "style", "culture"].map((c) => (
                    <option value={c} selected={post.category === c}>
                      {tEnum(t, "post_category", c)}
                    </option>
                  ))
                }
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium mb-1" for="status"
                >{t("admin.posts_detail.label_status")}</label
              >
              <select
                id="status"
                name="status"
                class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
              >
                {
                  ["draft", "published", "archived"].map((s) => (
                    <option value={s} selected={post.status === s}>
                      {tEnum(t, "status", s)}
                    </option>
                  ))
                }
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium mb-1" for="cover"
                >{t("admin.posts_detail.label_cover_url")}</label
              >
              <input
                id="cover"
                name="cover_image_url"
                value={post.cover_image_url ?? ""}
                class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base font-mono text-xs"
              />
            </div>
          </div>
          <button
            type="submit"
            class="px-4 py-2 bg-forest-700 text-bg-base rounded-md hover:bg-forest-900"
            >{t("admin.posts_detail.save_meta")}</button
          >
        </form>
      </div>
    </div>

    <div slot="translations">
      <div class="space-y-4 max-w-3xl">
        {
          LOCALES.map((loc) => {
            const tr = trByLocale(loc);
            return (
              <form
                method="POST"
                action={`/api/admin/posts/${id}/translations`}
                class="bg-bg-card border border-text-muted/20 rounded-card p-5 space-y-3"
              >
                <input type="hidden" name="locale" value={loc} />
                <h3 class="font-serif text-lg">{loc}</h3>
                <div>
                  <label
                    class="block text-sm font-medium mb-1"
                    for={`title-${loc}`}
                  >
                    {t("admin.posts_detail.label_title")}
                  </label>
                  <input
                    id={`title-${loc}`}
                    name="title"
                    value={tr?.title ?? ""}
                    class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
                  />
                </div>
                <div>
                  <label
                    class="block text-sm font-medium mb-1"
                    for={`excerpt-${loc}`}
                  >
                    {t("admin.posts_detail.label_excerpt")}
                  </label>
                  <textarea
                    id={`excerpt-${loc}`}
                    name="excerpt"
                    rows="2"
                    class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
                  >
                    {tr?.excerpt ?? ""}
                  </textarea>
                </div>
                <div>
                  <label
                    class="block text-sm font-medium mb-1"
                    for={`body-${loc}`}
                  >
                    {t("admin.posts_detail.label_body")}
                  </label>
                  <textarea
                    id={`body-${loc}`}
                    name="body_markdown"
                    rows="10"
                    class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base font-mono text-sm"
                  >
                    {tr?.body_markdown ?? ""}
                  </textarea>
                </div>
                <button
                  type="submit"
                  class="px-4 py-2 bg-forest-700 text-bg-base rounded-md hover:bg-forest-900 text-sm"
                >
                  {t("admin.posts_detail.save_translation", { loc })}
                </button>
              </form>
            );
          })
        }
      </div>

      <div slot="faq">
        <form
          method="POST"
          action={`/api/admin/posts/${id}/faq`}
          class="bg-bg-card border border-text-muted/20 rounded-card p-6 space-y-4 max-w-3xl"
        >
          <p class="text-sm text-text-secondary">
            {t("admin.posts_detail.faq_intro")}
          </p>
          {
            LOCALES.map((loc) => {
              let faqArr: { q: string; a: string }[] = [];
              if (post.faq) {
                try {
                  const parsed = JSON.parse(post.faq);
                  faqArr = Array.isArray(parsed?.[loc]) ? parsed[loc] : [];
                } catch (_) {
                  /* ignore */
                }
              }
              const faqJson = JSON.stringify(faqArr, null, 2);
              return (
                <div class="border border-text-muted/20 rounded-md p-4">
                  <h3 class="font-serif text-lg mb-2">{loc}</h3>
                  <label
                    class="block text-sm font-medium mb-1"
                    for={`faq-${loc}`}
                  >
                    {t("admin.posts_detail.label_faq_json", { loc })}
                  </label>
                  <textarea
                    id={`faq-${loc}`}
                    name={`faq_${loc}`}
                    rows="8"
                    class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base font-mono text-sm"
                  >
                    {faqJson}
                  </textarea>
                  <p class="text-xs text-text-muted mt-1">
                    {t("admin.posts_detail.hint_faq_json")}
                  </p>
                </div>
              );
            })
          }
          <button
            type="submit"
            class="px-4 py-2 bg-forest-700 text-bg-base rounded-md hover:bg-forest-900"
          >
            {t("admin.posts_detail.save_faq")}
          </button>
        </form>
      </div>
    </div>
  </Tabs>
</AdminLayout>
