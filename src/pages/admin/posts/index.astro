---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { env } from "cloudflare:workers";
import { createT, tEnum } from "../../../i18n/t";
import { defaultLocale, type Locale } from "../../../i18n/config";
import zhHansMessages from "../../../i18n/messages/zh-Hans.json";

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = zhHansMessages as Record<string, unknown>;
const t = createT(messages);
void locale;

const posts = env?.DB
  ? await env.DB.prepare(
      `SELECT p.id, p.slug, p.status, p.category, p.published_at, p.updated_at,
                pt.locale, pt.title
         FROM posts p
         LEFT JOIN post_translations pt ON pt.post_id = p.id AND pt.locale = ?
         ORDER BY p.updated_at DESC LIMIT 100`,
    )
      .bind(Astro.locals.locale)
      .all<{
        id: string;
        slug: string;
        status: string;
        category: string | null;
        published_at: number | null;
        updated_at: number;
        locale: string | null;
        title: string | null;
      }>()
  : { results: [] };

function statusColor(s: string) {
  return s === "published"
    ? "bg-success/20 text-success"
    : s === "archived"
      ? "bg-error/20 text-error"
      : "bg-warning/20 text-warning";
}
---

<AdminLayout title={t("admin.posts_list.title")} active="blog">
  <div class="flex justify-between items-center mb-6">
    <p class="text-text-secondary">
      {t("admin.posts_list.subtitle", { n: posts.results.length })}
    </p>
    <a
      href="/admin/posts/new"
      class="px-4 py-2 bg-forest-700 text-bg-base rounded-md hover:bg-forest-900 transition-colors"
      >{t("admin.posts_list.new_post")}</a
    >
  </div>

  <div
    class="bg-bg-card border border-text-muted/20 rounded-card overflow-x-auto"
  >
    <table class="w-full text-sm leading-normal">
      <thead class="bg-forest-100">
        <tr>
          <th
            class="text-left px-4 py-3 text-xs font-medium tracking-wide text-text-secondary"
            >{t("admin.posts_list.col_title")}</th
          >
          <th
            class="text-left px-4 py-3 text-xs font-medium tracking-wide text-text-secondary"
            >{t("admin.posts_list.col_slug")}</th
          >
          <th
            class="text-left px-4 py-3 text-xs font-medium tracking-wide text-text-secondary"
            >{t("admin.posts_list.col_category")}</th
          >
          <th
            class="text-left px-4 py-3 text-xs font-medium tracking-wide text-text-secondary"
            >{t("admin.posts_list.col_status")}</th
          >
          <th
            class="text-left px-4 py-3 text-xs font-medium tracking-wide text-text-secondary"
            >{t("admin.posts_list.col_updated")}</th
          >
          <th
            class="text-right px-4 py-3 text-xs font-medium tracking-wide text-text-secondary"
            >{t("admin.posts_list.col_actions")}</th
          >
        </tr>
      </thead>
      <tbody>
        {
          posts.results.length === 0 && (
            <tr>
              <td colspan="6" class="px-4 py-8 text-center text-text-muted">
                {t("admin.posts_list.empty")}
              </td>
            </tr>
          )
        }
        {
          posts.results.map((p) => (
            <tr class="border-t border-text-muted/10 hover:bg-forest-50 transition-colors">
              <td class="px-4 py-3 font-medium">
                {p.title ?? t("admin.posts_list.untitled")}
              </td>
              <td class="px-4 py-3 font-mono text-xs">{p.slug}</td>
              <td class="px-4 py-3 text-text-secondary">
                {p.category ? tEnum(t, "post_category", p.category) : "—"}
              </td>
              <td class="px-4 py-3">
                <span
                  class={`px-2 py-0.5 rounded text-xs ${statusColor(p.status)}`}
                >
                  {tEnum(t, "status", p.status)}
                </span>
              </td>
              <td class="px-4 py-3 text-xs text-text-muted">
                {new Date(p.updated_at * 1000).toISOString().slice(0, 10)}
              </td>
              <td class="px-4 py-3 text-right">
                <a
                  href={`/admin/posts/${p.id}`}
                  class="text-accent-700 hover:underline"
                >
                  {t("admin.posts_list.link_edit")}
                </a>
                <a
                  href={`/blog/${p.slug}`}
                  class="text-text-secondary hover:underline ml-3"
                >
                  {t("admin.posts_list.link_view")}
                </a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</AdminLayout>
