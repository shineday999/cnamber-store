---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { env } from "cloudflare:workers";
import Tabs from "../../../components/Tabs.astro";
import { createT, tEnum } from "../../../i18n/t";
import { defaultLocale, type Locale } from "../../../i18n/config";
import zhHansMessages from "../../../i18n/messages/zh-Hans.json";
import { formatPrice, RATES_FROM_USD } from "../../../lib/format";
import {
  CATEGORIES,
  SUBCATEGORIES,
  TAG_GROUPS,
  MAX_IMAGES,
  allowedTags,
  checkReadiness,
  isCategory,
  splitTags,
} from "../../../lib/admin-products";

const id = Astro.params.id;
const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = zhHansMessages as Record<string, unknown>;
const t = createT(messages);
void locale;

const product = env?.DB
  ? await env.DB.prepare("SELECT * FROM products WHERE id = ?").bind(id).first<{
      id: string;
      category: string;
      subcategory: string | null;
      slug: string;
      status: string;
      image_url: string | null;
      created_at: number;
      tags: string | null;
    }>()
  : null;

const translations = env?.DB
  ? await env.DB.prepare(
      "SELECT * FROM product_translations WHERE product_id = ?",
    )
      .bind(id)
      .all<{
        locale: string;
        name: string;
        description: string;
        short_description: string | null;
        story: string | null;
      }>()
  : { results: [] };

const variants = env?.DB
  ? await env.DB.prepare("SELECT * FROM product_variants WHERE product_id = ?")
      .bind(id)
      .all<{
        id: string;
        sku: string;
        attributes: string;
        stock: number;
        price_base: string;
      }>()
  : { results: [] };

const LOCALES = ["zh-Hans", "en", "ms-MY", "id-ID"] as const;

if (!product) {
  return Astro.redirect("/admin/products");
}

const trByLocale = (locale: string) =>
  translations.results.find((t) => t.locale === locale);

// ---- 規格、圖片、上架檢查、標籤 ----
const variantRow = env?.DB
  ? await env.DB.prepare(
      "SELECT id, sku, stock, weight_grams, image_urls FROM product_variants WHERE product_id = ? ORDER BY sku LIMIT 1",
    )
      .bind(product.id)
      .first<{
        id: string;
        sku: string;
        stock: number;
        weight_grams: number | null;
        image_urls: string;
      }>()
  : null;
const priceRow =
  variantRow && env?.DB
    ? await env.DB.prepare(
        "SELECT amount FROM product_prices WHERE variant_id = ? AND currency = 'USD'",
      )
        .bind(variantRow.id)
        .first<{ amount: number }>()
    : null;
let variantImages: string[] = [];
try {
  const parsed: unknown = variantRow ? JSON.parse(variantRow.image_urls) : [];
  if (Array.isArray(parsed)) {
    variantImages = parsed.filter((u): u is string => typeof u === "string");
  }
} catch {
  variantImages = [];
}
// 舊資料：只有 products.image_url 的，先當作目前圖片，儲存規格時會一併帶入規格
if (variantImages.length === 0 && product.image_url) {
  variantImages = [product.image_url];
}
const usdCents = priceRow?.amount ?? null;
// 後台以人民幣顯示（資料庫存美元，前台再依語系換算）
const cnyRaw =
  usdCents !== null ? (usdCents / 100) * (RATES_FROM_USD["CNY"] ?? 1) : null;
const priceValue =
  cnyRaw === null
    ? ""
    : Math.abs(cnyRaw - Math.round(cnyRaw)) < 0.05
      ? String(Math.round(cnyRaw))
      : cnyRaw.toFixed(2);
const missing = env?.DB ? await checkReadiness(env.DB, product.id) : [];
const notice = {
  created: Astro.url.searchParams.get("created"),
  blocked: Astro.url.searchParams.get("blocked"),
  saved: Astro.url.searchParams.get("saved"),
  error: Astro.url.searchParams.get("error"),
};
const productCategory = isCategory(product.category)
  ? product.category
  : "jewelry";
const currentTags = splitTags(product.tags ?? "");
const presetTags = new Set(CATEGORIES.flatMap((c) => [...allowedTags(c)]));
const extraTags = currentTags.filter((tk) => !presetTags.has(tk));
const knownSub = CATEGORIES.some((c) =>
  SUBCATEGORIES[c].includes(product.subcategory ?? ""),
);
const inputField =
  "w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base";
---

<AdminLayout
  title={`${t("admin.products_detail.title_prefix")}${product.slug}`}
  active="products"
>
  {
    notice.created && (
      <div class="mb-4 max-w-3xl rounded-card border border-forest-700/30 bg-forest-50 p-4 text-sm">
        {notice.created === "active" ? "已创建并上架。" : "已创建为草稿。"}
        {notice.blocked
          ? `想上架但还缺：${notice.blocked}，请到「变体」页签补齐。`
          : ""}
      </div>
    )
  }
  {
    notice.saved && !notice.created && (
      <div class="mb-4 max-w-3xl rounded-card border border-forest-700/30 bg-forest-50 p-4 text-sm">
        已保存。
      </div>
    )
  }
  {
    notice.error && (
      <div
        role="alert"
        class="mb-4 max-w-3xl rounded-card border border-error/40 bg-error/10 p-4 text-sm text-error"
      >
        {notice.error}
      </div>
    )
  }
  {
    product.status === "draft" && (
      <div class="mb-4 max-w-3xl rounded-card border border-text-muted/20 bg-bg-card p-4">
        <p class="font-medium mb-2">上架前检查</p>
        {missing.length === 0 ? (
          <>
            <p class="text-sm text-forest-700 mb-3">✓ 资料都齐了，可以上架。</p>
            <form method="POST" action={`/api/admin/products/${id}/status`}>
              <button
                type="submit"
                class="px-4 py-2 bg-forest-700 text-bg-base rounded-md hover:bg-forest-900 transition-colors"
              >
                立即上架
              </button>
            </form>
          </>
        ) : (
          <>
            <ul class="mb-3 space-y-1 text-sm">
              {missing.map((m) => (
                <li class="text-error">✗ 还缺：{m}</li>
              ))}
            </ul>
            <a
              href={`/admin/products/${id}?tab=variants`}
              class="text-sm underline text-accent-700"
            >
              去补齐 →
            </a>
          </>
        )}
      </div>
    )
  }
  <Tabs
    tabs={[
      { id: "core", label: t("admin.products_detail.tab_core") },
      {
        id: "translations",
        label: t("admin.products_detail.tab_translations"),
      },
      { id: "variants", label: t("admin.products_detail.tab_variants") },
    ]}
    defaultTab="core"
  >
    <div slot="core">
      <p class="mb-4 max-w-2xl text-sm text-text-muted">
        图片、售价、库存都在「变体」页签里管理。
      </p>
      <form
        method="POST"
        action={`/api/admin/products/${id}`}
        class="bg-bg-card border border-text-muted/20 rounded-card p-6 space-y-4 max-w-2xl"
      >
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium mb-1" for="category"
              >{t("admin.products_detail.label_category")}</label
            >
            <select
              id="category"
              name="category"
              class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
            >
              <option value="jewelry" selected={product.category === "jewelry"}
                >{t("admin.products_detail.option_jewelry")}</option
              >
              <option value="incense" selected={product.category === "incense"}
                >{t("admin.products_detail.option_incense")}</option
              >
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium mb-1" for="status"
              >{t("admin.products_detail.label_status")}</label
            >
            <select
              id="status"
              name="status"
              class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
            >
              {
                ["draft", "active", "archived"].map((s) => (
                  <option value={s} selected={product.status === s}>
                    {tEnum(t, "status", s)}
                  </option>
                ))
              }
            </select>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" for="subcategory"
            >{t("admin.products_detail.label_subcategory")}</label
          >
          <select id="subcategory" name="subcategory" class={inputField}>
            <option value="">—</option>
            {
              CATEGORIES.map((c) =>
                SUBCATEGORIES[c].map((s) => (
                  <option
                    value={s}
                    data-cat={c}
                    selected={product.subcategory === s}
                  >
                    {tEnum(t, "subcategory", s)}
                  </option>
                )),
              )
            }
            {
              product.subcategory && !knownSub && (
                <option value={product.subcategory} selected>
                  {product.subcategory}
                </option>
              )
            }
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" for="slug"
            >{t("admin.products_detail.label_slug")}</label
          >
          <input
            id="slug"
            name="slug"
            value={product.slug}
            readonly
            class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base font-mono text-text-secondary"
          />
          <p class="text-xs text-text-muted mt-1">
            编号由系统自动生成，前台网址会用到它，所以不能修改。
          </p>
        </div>
        <div>
          <p class="block text-sm font-medium mb-1">
            {t("admin.products_form.tags")}
          </p>
          <p class="text-xs text-text-muted mb-3">
            「为我推荐」测验会拿客人的答案来比对这些标签。
          </p>
          <input type="hidden" name="tags_extra" value={extraTags.join(",")} />
          {
            CATEGORIES.map((c) => (
              <div
                data-tag-cat={c}
                hidden={productCategory !== c}
                class="space-y-4"
              >
                {TAG_GROUPS[c].map((g) => (
                  <fieldset>
                    <legend class="text-sm font-medium mb-2">
                      {t(g.titleKey)}
                    </legend>
                    <div class="flex flex-wrap gap-2">
                      {g.options.map((o) => (
                        <label class="cursor-pointer rounded-full border border-text-muted/30 px-3 py-1.5 text-sm transition-colors has-[:checked]:border-forest-700 has-[:checked]:bg-forest-700 has-[:checked]:text-bg-base has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-accent-500/40">
                          <input
                            type="checkbox"
                            name="tag"
                            value={o.value}
                            checked={currentTags.includes(o.value)}
                            disabled={productCategory !== c}
                            class="sr-only"
                          />
                          {t(o.labelKey)}
                        </label>
                      ))}
                    </div>
                  </fieldset>
                ))}
              </div>
            ))
          }
          {
            extraTags.length > 0 && (
              <p class="text-xs text-text-muted mt-3">
                其他沿用的标签：{extraTags.join("、")}（保存时保留）
              </p>
            )
          }
        </div>
        <div class="flex gap-2">
          <button
            type="submit"
            class="px-4 py-2 bg-forest-700 text-bg-base rounded-md hover:bg-forest-900 transition-colors"
            >{t("admin.products_detail.save")}</button
          >
          <button
            type="submit"
            formaction={`/api/admin/products/${id}/status`}
            formmethod="POST"
            class="px-4 py-2 border border-text-muted/30 rounded-md hover:bg-bg-base transition-colors"
            >{
              product.status === "draft"
                ? t("admin.products_detail.toggle_to_active")
                : product.status === "active"
                  ? t("admin.products_detail.toggle_to_archived")
                  : t("admin.products_detail.toggle_to_draft")
            }</button
          >
          <button
            type="button"
            class="px-4 py-2 ml-auto border border-error/40 text-error rounded-md hover:bg-error/10 transition-colors"
            onclick={`if (!confirm('确定删除该产品？所有变体、翻译、评论都会一并删除。')) return false; const f = document.createElement('form'); f.method='POST'; f.action='/api/admin/products/${id}'; const i=document.createElement('input'); i.type='hidden'; i.name='_action'; i.value='delete'; f.appendChild(i); document.body.appendChild(f); f.submit();`}
          >
            {t("admin.products_detail.delete")}
          </button>
        </div>
      </form>
    </div>

    <div slot="translations">
      <div class="space-y-6 max-w-3xl">
        {
          LOCALES.map((loc) => {
            const tr = trByLocale(loc);
            return (
              <form
                method="POST"
                action={`/api/admin/products/${id}/translations`}
                class="bg-bg-card border border-text-muted/20 rounded-card p-6 space-y-3"
              >
                <input type="hidden" name="locale" value={loc} />
                <h3 class="font-serif text-lg">{loc}</h3>
                <div>
                  <label
                    class="block text-sm font-medium mb-1"
                    for={`name-${loc}`}
                  >
                    {t("admin.products_detail.label_name")}
                  </label>
                  <input
                    id={`name-${loc}`}
                    name="name"
                    value={tr?.name ?? ""}
                    required
                    class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
                  />
                </div>
                <div>
                  <label
                    class="block text-sm font-medium mb-1"
                    for={`short-${loc}`}
                  >
                    {t("admin.products_detail.label_short_desc")}
                  </label>
                  <input
                    id={`short-${loc}`}
                    name="short_description"
                    value={tr?.short_description ?? ""}
                    class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
                  />
                </div>
                <div>
                  <label
                    class="block text-sm font-medium mb-1"
                    for={`desc-${loc}`}
                  >
                    {t("admin.products_detail.label_description")}
                  </label>
                  <textarea
                    id={`desc-${loc}`}
                    name="description"
                    rows="4"
                    required
                    class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
                  >
                    {tr?.description ?? ""}
                  </textarea>
                </div>
                <div>
                  <label
                    class="block text-sm font-medium mb-1"
                    for={`story-${loc}`}
                  >
                    {t("admin.products_detail.label_story")}
                  </label>
                  <textarea
                    id={`story-${loc}`}
                    name="story"
                    rows="3"
                    class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
                  >
                    {tr?.story ?? ""}
                  </textarea>
                </div>
                <button
                  type="submit"
                  class="px-4 py-2 bg-forest-700 text-bg-base rounded-md hover:bg-forest-900 transition-colors text-sm"
                >
                  {t("admin.products_detail.save_translation", { loc })}
                </button>
              </form>
            );
          })
        }
      </div>
    </div>

    <div slot="variants">
      <div class="space-y-4 max-w-3xl">
        {
          !variantRow && (
            <p class="rounded-card border border-accent-500/40 bg-accent-500/10 p-4 text-sm">
              这个商品还没有规格（售价、库存、图片）。填写下面的表单并保存后，才能上架。
            </p>
          )
        }
        <form
          method="POST"
          action={`/api/admin/products/${id}/variant`}
          enctype="multipart/form-data"
          class="bg-bg-card border border-text-muted/20 rounded-card p-5 sm:p-6 space-y-4"
        >
          <input type="hidden" name="variant_id" value={variantRow?.id ?? ""} />
          {
            variantRow && (
              <p class="text-sm text-text-muted">
                规格编号：
                <span class="font-mono text-text-secondary">
                  {variantRow.sku}
                </span>
              </p>
            )
          }

          <div class="grid grid-cols-3 gap-3">
            <div class="col-span-2">
              <label class="block text-sm font-medium mb-1" for="v-price"
                >售价 <span class="text-error">*</span></label
              >
              <input
                id="v-price"
                name="price"
                type="text"
                inputmode="decimal"
                required
                value={priceValue}
                class={inputField}
              />
            </div>
            <div>
              <label class="block text-sm font-medium mb-1" for="v-currency"
                >币别</label
              >
              <select id="v-currency" name="currency" class={inputField}>
                <option value="USD">美元 $</option>
                <option value="CNY" selected>人民币 ¥</option>
              </select>
            </div>
          </div>
          {
            usdCents !== null && (
              <p class="text-xs text-text-muted -mt-2">
                前台简体站显示 {formatPrice(usdCents, "USD", "zh-Hans")}
                （系统以美元储存，依汇率换算）。上方金额以所选币别为准。
              </p>
            )
          }

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-sm font-medium mb-1" for="v-stock"
                >库存 <span class="text-error">*</span></label
              >
              <input
                id="v-stock"
                name="stock"
                type="number"
                min="0"
                step="1"
                required
                value={variantRow?.stock ?? 1}
                class={inputField}
              />
            </div>
            <div>
              <label class="block text-sm font-medium mb-1" for="v-weight"
                >重量（克，选填）</label
              >
              <input
                id="v-weight"
                name="weight"
                type="number"
                min="0"
                step="1"
                value={variantRow?.weight_grams ?? ""}
                class={inputField}
              />
            </div>
          </div>

          <div>
            <p class="block text-sm font-medium mb-2">图片（第一张是封面）</p>
            {
              variantImages.length > 0 ? (
                <div class="grid grid-cols-3 sm:grid-cols-4 gap-3">
                  {variantImages.map((u, i) => (
                    <div class="space-y-1">
                      <img
                        loading="lazy"
                        decoding="async"
                        src={u}
                        alt=""
                        class="w-full aspect-square object-cover rounded border border-text-muted/20"
                      />
                      <label class="flex items-center gap-1 text-xs">
                        <input
                          type="radio"
                          name="cover"
                          value={u}
                          checked={i === 0}
                          class="accent-forest-700"
                        />
                        封面
                      </label>
                      <label class="flex items-center gap-1 text-xs text-error">
                        <input type="checkbox" name="remove" value={u} />
                        删除
                      </label>
                    </div>
                  ))}
                </div>
              ) : (
                <p class="text-sm text-text-muted">还没有图片。</p>
              )
            }
            <div class="mt-3">
              <label class="block text-sm font-medium mb-1" for="v-images"
                >新增图片（可多选）</label
              >
              <input
                id="v-images"
                name="images"
                type="file"
                multiple
                accept="image/jpeg,image/png,image/webp,image/gif"
                class="w-full text-sm file:mr-2 file:py-1 file:px-3 file:border-0 file:bg-forest-700 file:text-bg-base file:rounded file:cursor-pointer"
              />
              <p class="text-xs text-text-muted mt-1">
                最多 {MAX_IMAGES} 张（含已有的），每张 5MB 以内。
              </p>
            </div>
          </div>

          <button
            type="submit"
            class="px-4 py-2 bg-forest-700 text-bg-base rounded-md hover:bg-forest-900 transition-colors"
          >
            保存规格
          </button>
        </form>
      </div>
    </div>
  </Tabs>
  <script is:inline>
    (function () {
      var cat = document.getElementById("category");
      var sub = document.getElementById("subcategory");
      if (!cat || !sub) return;
      function apply() {
        var c = cat.value;
        Array.prototype.forEach.call(
          sub.querySelectorAll("option[data-cat]"),
          function (o) {
            var show = o.getAttribute("data-cat") === c;
            o.hidden = !show;
            o.disabled = !show;
          },
        );
        var sel = sub.options[sub.selectedIndex];
        if (
          sel &&
          sel.getAttribute("data-cat") &&
          sel.getAttribute("data-cat") !== c
        ) {
          sub.value = "";
        }
        Array.prototype.forEach.call(
          document.querySelectorAll("[data-tag-cat]"),
          function (g) {
            var show = g.getAttribute("data-tag-cat") === c;
            g.hidden = !show;
            Array.prototype.forEach.call(
              g.querySelectorAll("input"),
              function (i) {
                i.disabled = !show;
              },
            );
          },
        );
      }
      cat.addEventListener("change", apply);
      apply();
    })();
  </script>
</AdminLayout>
