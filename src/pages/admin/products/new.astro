---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { createT } from "../../../i18n/t";
import { defaultLocale, type Locale } from "../../../i18n/config";

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);
void locale;
---

<AdminLayout title={t("admin.products_new.title")} active="products">
  <p class="text-text-secondary mb-6">{t("admin.products_new.subtitle")}</p>

  <form
    method="POST"
    action="/api/admin/products"
    class="bg-bg-card border border-text-muted/20 rounded-card p-6 space-y-4 max-w-2xl"
  >
    <div>
      <label class="block text-sm font-medium mb-1" for="category"
        >{t("admin.products_new.label_category")}</label
      >
      <select
        id="category"
        name="category"
        required
        class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
      >
        <option value="jewelry">{t("admin.products_new.option_jewelry")}</option
        >
        <option value="incense">{t("admin.products_new.option_incense")}</option
        >
      </select>
    </div>
    <div>
      <label class="block text-sm font-medium mb-1" for="subcategory"
        >{t("admin.products_new.label_subcategory")}</label
      >
      <input
        id="subcategory"
        name="subcategory"
        type="text"
        placeholder="necklace / bracelet / stick / balm"
        class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
      />
    </div>
    <div>
      <label class="block text-sm font-medium mb-1" for="slug"
        >{t("admin.products_new.label_slug")}</label
      >
      <input
        id="slug"
        name="slug"
        type="text"
        required
        placeholder="baltic-amber-pendant"
        class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base font-mono"
      />
    </div>

    <div class="border-t border-text-muted/20 pt-4">
      <h3 class="font-medium mb-3">{t("admin.products_new.initial_name")}</h3>
      <input
        name="translations[zh-Hans][name]"
        type="text"
        placeholder="波罗的海琥珀吊坠"
        class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base mb-2"
      />
      <textarea
        name="translations[zh-Hans][description]"
        rows="3"
        placeholder="Description in 简体中文"
        class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
      ></textarea>
    </div>

    <div class="flex gap-2 pt-2">
      <button
        type="submit"
        class="px-4 py-2 bg-forest-700 text-bg-base rounded-md hover:bg-forest-900"
      >
        {t("admin.products_new.create_draft")}
      </button>
      <a
        href="/admin/products"
        class="px-4 py-2 border border-text-muted/30 rounded-md hover:bg-bg-base"
      >
        {t("admin.products_new.cancel")}
      </a>
    </div>
  </form>
</AdminLayout>
