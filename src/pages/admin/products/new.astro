---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="New Product" active="products">
  <p class="text-text-secondary mb-6">
    Product creation form. Phase 2 sub-task P2-4 will wire the full form (4-language tabs, variants, multi-currency pricing).
  </p>

  <form method="POST" action="/api/admin/products" class="bg-bg-card border border-text-muted/20 rounded-card p-6 space-y-4 max-w-2xl">
    <div>
      <label class="block text-sm font-medium mb-1" for="category">Category</label>
      <select id="category" name="category" required class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base">
        <option value="jewelry">Jewelry</option>
        <option value="incense">Incense</option>
      </select>
    </div>
    <div>
      <label class="block text-sm font-medium mb-1" for="subcategory">Subcategory</label>
      <input id="subcategory" name="subcategory" type="text" placeholder="necklace / bracelet / stick / balm" class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base" />
    </div>
    <div>
      <label class="block text-sm font-medium mb-1" for="slug">Slug</label>
      <input id="slug" name="slug" type="text" required placeholder="baltic-amber-pendant" class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base font-mono" />
    </div>

    <div class="border-t border-text-muted/20 pt-4">
      <h3 class="font-medium mb-3">Initial name (zh-Hans default)</h3>
      <input name="translations[zh-Hans][name]" type="text" placeholder="波罗的海琥珀吊坠" class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base mb-2" />
      <textarea name="translations[zh-Hans][description]" rows="3" placeholder="Description in 简体中文" class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"></textarea>
    </div>

    <div class="flex gap-2 pt-2">
      <button type="submit" class="px-4 py-2 bg-primary-700 text-bg-base rounded-md hover:bg-primary-900">
        Create Draft
      </button>
      <a href="/admin/products" class="px-4 py-2 border border-text-muted/30 rounded-md hover:bg-bg-base">
        Cancel
      </a>
    </div>
  </form>
</AdminLayout>