---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { createT, tEnum } from "../../../i18n/t";
import { defaultLocale, type Locale } from "../../../i18n/config";
import zhHansMessages from "../../../i18n/messages/zh-Hans.json";

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = zhHansMessages as Record<string, unknown>;
const t = createT(messages);
void locale;

// All subcategories grouped by parent category for the dropdown.
const JEWELRY_SUBS = ["necklace", "bracelet", "earring", "ring"] as const;
const INCENSE_SUBS = ["stick", "balm", "oil"] as const;
---

<AdminLayout title={t("admin.products_new.title")} active="products">
  <p class="text-text-secondary mb-6">{t("admin.products_new.subtitle")}</p>

  <form
    method="POST"
    action="/api/admin/products"
    class="bg-bg-card border border-text-muted/20 rounded-card p-6 space-y-4 max-w-2xl"
  >
    <div>
      <label class="block text-sm font-medium mb-1" for="category"
        >{t("admin.products_new.label_category")}</label
      >
      <select
        id="category"
        name="category"
        required
        class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
      >
        <option value="jewelry">{t("admin.products_new.option_jewelry")}</option
        >
        <option value="incense">{t("admin.products_new.option_incense")}</option
        >
      </select>
    </div>
    <div>
      <label class="block text-sm font-medium mb-1" for="subcategory"
        >{t("admin.products_new.label_subcategory")}</label
      >
      <select
        id="subcategory"
        name="subcategory"
        class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
      >
        <option value="">—</option>
        <optgroup label={t("admin.products_new.option_jewelry")}>
          {
            JEWELRY_SUBS.map((s) => (
              <option value={s}>{tEnum(t, "subcategory", s)}</option>
            ))
          }
        </optgroup>
        <optgroup label={t("admin.products_new.option_incense")}>
          {
            INCENSE_SUBS.map((s) => (
              <option value={s}>{tEnum(t, "subcategory", s)}</option>
            ))
          }
        </optgroup>
      </select>
    </div>
    <div>
      <label class="block text-sm font-medium mb-1" for="slug"
        >{t("admin.products_new.label_slug")}</label
      >
      <input
        id="slug"
        name="slug"
        type="text"
        required
        placeholder={t("admin.products_new.placeholder_slug")}
        class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base font-mono"
      />
    </div>

    <div>
      <label class="block text-sm font-medium mb-1" for="image"
        >{t("admin.products_new.label_image")}</label
      >
      <input
        id="image"
        name="image"
        type="file"
        accept="image/jpeg,image/png,image/webp,image/gif"
        class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base file:mr-4 file:py-1 file:px-3 file:border-0 file:bg-forest-700 file:text-bg-base file:rounded file:cursor-pointer text-sm"
      />
      <p class="text-xs text-text-muted mt-1">
        {t("admin.products_new.hint_image")}
      </p>
    </div>

    <div class="border-t border-text-muted/20 pt-4">
      <h3 class="font-medium mb-3">{t("admin.products_new.initial_name")}</h3>
      <input
        name="translations[zh-Hans][name]"
        type="text"
        placeholder={t("admin.products_new.placeholder_name")}
        class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base mb-2"
      />
      <textarea
        name="translations[zh-Hans][description]"
        rows="3"
        placeholder={t("admin.products_new.placeholder_description")}
        class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
      ></textarea>
    </div>

    <div class="flex gap-2 pt-2">
      <button
        type="submit"
        class="px-4 py-2 bg-forest-700 text-bg-base rounded-md hover:bg-forest-900"
      >
        {t("admin.products_new.create_draft")}
      </button>
      <a
        href="/admin/products"
        class="px-4 py-2 border border-text-muted/30 rounded-md hover:bg-bg-base"
      >
        {t("admin.products_new.cancel")}
      </a>
    </div>
  </form>
</AdminLayout>
