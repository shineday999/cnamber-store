---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { env } from "cloudflare:workers";
import { createT, tEnum } from "../../../i18n/t";
import { defaultLocale, type Locale } from "../../../i18n/config";
import zhHansMessages from "../../../i18n/messages/zh-Hans.json";
import { formatPrice } from "../../../lib/format";

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = zhHansMessages as Record<string, unknown>;
const t = createT(messages);
void locale;

const products = env?.DB
  ? await env.DB.prepare(
      `SELECT p.id, p.slug, p.category, p.subcategory, p.status, p.image_url, p.created_at,
              pt.name AS name_zh,
              (SELECT pp.amount FROM product_variants pv
                 JOIN product_prices pp
                   ON pp.variant_id = pv.id AND pp.currency = 'USD'
                WHERE pv.product_id = p.id
                ORDER BY pv.sku LIMIT 1) AS usd_cents
       FROM products p
       LEFT JOIN product_translations pt
         ON pt.product_id = p.id AND pt.locale = 'zh-Hans'
       ORDER BY p.created_at DESC LIMIT 100`,
    ).all<{
      id: string;
      slug: string;
      category: string;
      subcategory: string | null;
      status: string;
      image_url: string | null;
      created_at: number;
      name_zh: string | null;
      usd_cents: number | null;
    }>()
  : {
      results: [] as Array<{
        id: string;
        slug: string;
        category: string;
        subcategory: string | null;
        status: string;
        image_url: string | null;
        created_at: number;
        name_zh: string | null;
        usd_cents: number | null;
      }>,
    };
---

<AdminLayout title={t("admin.products_list.title")} active="products">
  <div class="flex items-center justify-between mb-6">
    <p class="text-text-secondary">
      {t("admin.products_list.subtitle", { n: products.results.length })}
    </p>
    <a
      href="/admin/products/new"
      class="px-4 py-2 bg-forest-700 text-bg-base rounded-md hover:bg-forest-900 transition-colors"
    >
      {t("admin.products_list.new_product")}
    </a>
  </div>

  <div
    class="bg-bg-card border border-text-muted/20 rounded-card overflow-x-auto"
  >
    <table class="w-full text-sm leading-normal">
      <thead class="bg-forest-100">
        <tr>
          <th
            class="text-left px-4 py-3 text-xs font-medium tracking-wide text-text-secondary"
            >{t("admin.products_list.col_id")}</th
          >
          <th
            class="text-left px-4 py-3 text-xs font-medium tracking-wide text-text-secondary"
            >{t("admin.products_list.col_image")}</th
          >
          <th
            class="text-left px-4 py-3 text-xs font-medium tracking-wide text-text-secondary"
            >{t("admin.products_list.col_name")}</th
          >
          <th
            class="text-left px-4 py-3 text-xs font-medium tracking-wide text-text-secondary"
            >售价</th
          >
          <th
            class="text-left px-4 py-3 text-xs font-medium tracking-wide text-text-secondary"
            >{t("admin.products_list.col_slug")}</th
          >
          <th
            class="text-left px-4 py-3 text-xs font-medium tracking-wide text-text-secondary"
            >{t("admin.products_list.col_category")}</th
          >
          <th
            class="text-left px-4 py-3 text-xs font-medium tracking-wide text-text-secondary"
            >{t("admin.products_list.col_subcategory")}</th
          >
          <th
            class="text-left px-4 py-3 text-xs font-medium tracking-wide text-text-secondary"
            >{t("admin.products_list.col_status")}</th
          >
          <th
            class="text-right px-4 py-3 text-xs font-medium tracking-wide text-text-secondary"
            >{t("admin.products_list.col_actions")}</th
          >
        </tr>
      </thead>
      <tbody>
        {
          products.results.length === 0 && (
            <tr>
              <td colspan="9" class="px-4 py-8 text-center text-text-muted">
                {t("admin.products_list.empty")}{" "}
                <a href="/admin/products/new" class="text-accent-700 underline">
                  {t("admin.products_list.empty_link")}
                </a>
                .
              </td>
            </tr>
          )
        }
        {
          products.results.map((p) => (
            <tr class="border-t border-text-muted/10 hover:bg-forest-50 transition-colors">
              <td class="px-4 py-3 font-mono text-xs">{p.id as string}</td>
              <td class="px-4 py-3">
                {p.image_url ? (
                  <img
                    loading="lazy"
                    decoding="async"
                    src={p.image_url as string}
                    alt={p.slug as string}
                    class="w-12 h-12 object-cover rounded border border-text-muted/20"
                  />
                ) : (
                  <div class="w-12 h-12 rounded bg-text-muted/10 flex items-center justify-center text-text-muted text-xs">
                    —
                  </div>
                )}
              </td>
              <td class="px-4 py-3 font-medium">
                {(p.name_zh as string | null) ?? "—"}
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                {p.usd_cents != null ? (
                  formatPrice(p.usd_cents, "USD", "zh-Hans")
                ) : (
                  <span class="text-text-muted">—</span>
                )}
              </td>
              <td class="px-4 py-3 font-mono text-xs text-text-secondary">
                {p.slug as string}
              </td>
              <td class="px-4 py-3">
                {tEnum(t, "category", p.category as string)}
              </td>
              <td class="px-4 py-3">
                {(p.subcategory as string)
                  ? tEnum(t, "subcategory", p.subcategory as string)
                  : "—"}
              </td>
              <td class="px-4 py-3">
                <span
                  class={`px-2 py-0.5 rounded text-xs ${
                    p.status === "active"
                      ? "bg-success/20 text-success"
                      : p.status === "archived"
                        ? "bg-error/20 text-error"
                        : "bg-warning/20 text-warning"
                  }`}
                >
                  {tEnum(t, "status", p.status as string)}
                </span>
              </td>
              <td class="px-4 py-3 text-right whitespace-nowrap">
                <a
                  href={`/admin/products/${p.id}`}
                  class="text-accent-700 hover:underline"
                >
                  {t("admin.products_list.link_edit")}
                </a>
                <form
                  method="POST"
                  action={`/api/admin/products/${p.id}`}
                  class="inline ml-3"
                  onsubmit="return confirm('确定删除该产品？此操作无法撤销。')"
                >
                  <input type="hidden" name="_action" value="delete" />
                  <button
                    type="submit"
                    class="text-error hover:underline text-sm"
                  >
                    {t("admin.products_list.delete")}
                  </button>
                </form>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</AdminLayout>
