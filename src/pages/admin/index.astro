---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createT } from "../../i18n/t";
import { defaultLocale, type Locale } from "../../i18n/config";

const env = Astro.locals.runtime?.env;
const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);
void locale;

let stats = { products: 0, orders: 0, pendingReviews: 0, totalRevenue: 0 };

if (env?.DB) {
  try {
    const products = await env.DB.prepare(
      "SELECT COUNT(*) AS c FROM products",
    ).first<{ c: number }>();
    const orders = await env.DB.prepare(
      "SELECT COUNT(*) AS c FROM orders",
    ).first<{ c: number }>();
    const reviews = await env.DB.prepare(
      "SELECT COUNT(*) AS c FROM reviews WHERE status = 'pending'",
    ).first<{ c: number }>();
    const revenue = await env.DB.prepare(
      "SELECT COALESCE(SUM(total), 0) AS s FROM orders WHERE payment_status = 'paid'",
    ).first<{ s: number }>();
    stats = {
      products: products?.c ?? 0,
      orders: orders?.c ?? 0,
      pendingReviews: reviews?.c ?? 0,
      totalRevenue: revenue?.s ?? 0,
    };
  } catch (e) {
    console.error("[admin dashboard] DB query failed", e);
  }
}
---

<AdminLayout title="Dashboard" active="dashboard">
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
    <div class="bg-bg-card border border-text-muted/20 rounded-card p-5">
      <div class="text-sm uppercase tracking-wider text-text-muted">
        {t("admin.dashboard.stat_products")}
      </div>
      <div class="text-3xl font-serif mt-2 text-forest-700">
        {stats.products}
      </div>
    </div>
    <div class="bg-bg-card border border-text-muted/20 rounded-card p-5">
      <div class="text-sm uppercase tracking-wider text-text-muted">
        {t("admin.dashboard.stat_orders")}
      </div>
      <div class="text-3xl font-serif mt-2 text-forest-700">{stats.orders}</div>
    </div>
    <div class="bg-bg-card border border-text-muted/20 rounded-card p-5">
      <div class="text-sm uppercase tracking-wider text-text-muted">
        {t("admin.dashboard.stat_pending_reviews")}
      </div>
      <div class="text-3xl font-serif mt-2 text-accent-700">
        {stats.pendingReviews}
      </div>
    </div>
    <div class="bg-bg-card border border-text-muted/20 rounded-card p-5">
      <div class="text-sm uppercase tracking-wider text-text-muted">
        {t("admin.dashboard.stat_revenue")}
      </div>
      <div class="text-3xl font-serif mt-2 text-success">
        {stats.totalRevenue}
      </div>
    </div>
  </div>

  <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4">
    <a
      href="/admin/products"
      class="block bg-bg-card border border-text-muted/20 rounded-card p-6 hover:border-accent-500 transition-colors"
    >
      <h2 class="font-serif text-xl mb-2">
        {t("admin.dashboard.manage_products")}
      </h2>
      <p class="text-sm text-text-secondary">
        Add, edit, archive inventory. Edit 4-language translations.
      </p>
    </a>
    <a
      href="/admin/orders"
      class="block bg-bg-card border border-text-muted/20 rounded-card p-6 hover:border-accent-500 transition-colors"
    >
      <h2 class="font-serif text-xl mb-2">
        {t("admin.dashboard.manage_orders")}
      </h2>
      <p class="text-sm text-text-secondary">
        View reservation orders, mark paid, update shipping status.
      </p>
    </a>
    <a
      href="/admin/reviews"
      class="block bg-bg-card border border-text-muted/20 rounded-card p-6 hover:border-accent-500 transition-colors"
    >
      <h2 class="font-serif text-xl mb-2">
        {t("admin.dashboard.review_moderation")}
      </h2>
      <p class="text-sm text-text-secondary">
        {t("admin.dashboard.review_moderation_desc")}
      </p>
    </a>
    <div
      class="block bg-bg-card border border-text-muted/20 rounded-card p-6 opacity-60 cursor-not-allowed"
    >
      <h2 class="font-serif text-xl mb-2">{t("admin.dashboard.blog_phase")}</h2>
      <p class="text-sm text-text-secondary">
        {t("admin.dashboard.blog_phase_desc")}
      </p>
    </div>
  </div>
</AdminLayout>
