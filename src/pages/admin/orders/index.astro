---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { createT } from "../../../i18n/t";
import { defaultLocale, type Locale } from "../../../i18n/config";
import zhHansMessages from "../../../i18n/messages/zh-Hans.json";

const env = Astro.locals.runtime?.env;
const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = zhHansMessages as Record<string, unknown>;
const t = createT(messages);
void locale;

const orders = env?.DB
  ? await env.DB.prepare(
      "SELECT id, customer_email, customer_name, total, currency, status, payment_status, created_at FROM orders ORDER BY created_at DESC LIMIT 100",
    ).all()
  : { results: [] as Array<Record<string, unknown>> };

function statusColor(s: string) {
  return s === "pending"
    ? "bg-warning/20 text-warning"
    : s === "confirmed" || s === "shipped"
      ? "bg-forest-100 text-forest-700"
      : s === "delivered"
        ? "bg-success/20 text-success"
        : "bg-error/20 text-error";
}
---

<AdminLayout title={t("admin.orders_list.title")} active="orders">
  <p class="text-text-secondary mb-6">
    {t("admin.orders_list.subtitle", { n: orders.results.length })}
  </p>

  <div
    class="bg-bg-card border border-text-muted/20 rounded-card overflow-hidden"
  >
    <table class="w-full text-sm">
      <thead class="bg-forest-100 text-text-primary">
        <tr>
          <th class="text-left px-4 py-3 font-medium"
            >{t("admin.orders_list.col_order_id")}</th
          >
          <th class="text-left px-4 py-3 font-medium"
            >{t("admin.orders_list.col_customer")}</th
          >
          <th class="text-right px-4 py-3 font-medium"
            >{t("admin.orders_list.col_total")}</th
          >
          <th class="text-left px-4 py-3 font-medium"
            >{t("admin.orders_list.col_status")}</th
          >
          <th class="text-left px-4 py-3 font-medium"
            >{t("admin.orders_list.col_payment")}</th
          >
          <th class="text-left px-4 py-3 font-medium"
            >{t("admin.orders_list.col_created")}</th
          >
        </tr>
      </thead>
      <tbody>
        {
          orders.results.length === 0 && (
            <tr>
              <td colspan="6" class="px-4 py-8 text-center text-text-muted">
                {t("admin.orders_list.empty")}
              </td>
            </tr>
          )
        }
        {
          orders.results.map((o) => (
            <tr class="border-t border-text-muted/10 hover:bg-bg-base">
              <td class="px-4 py-3 font-mono text-xs">{o.id as string}</td>
              <td class="px-4 py-3">
                <div class="font-medium">{o.customer_name as string}</div>
                <div class="text-xs text-text-muted">
                  {o.customer_email as string}
                </div>
              </td>
              <td class="px-4 py-3 text-right font-mono">
                {o.total as number} {o.currency as string}
              </td>
              <td class="px-4 py-3">
                <span
                  class={`px-2 py-0.5 rounded text-xs ${statusColor(o.status as string)}`}
                >
                  {o.status as string}
                </span>
              </td>
              <td class="px-4 py-3">
                <span
                  class={`px-2 py-0.5 rounded text-xs ${statusColor(o.payment_status as string)}`}
                >
                  {o.payment_status as string}
                </span>
              </td>
              <td class="px-4 py-3 text-xs font-mono text-text-muted">
                {new Date((o.created_at as number) * 1000)
                  .toISOString()
                  .slice(0, 16)}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</AdminLayout>
