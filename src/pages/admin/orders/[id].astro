---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { createT } from "../../../i18n/t";
import { defaultLocale, type Locale } from "../../../i18n/config";

const id = Astro.params.id;
const env = Astro.locals.runtime?.env;
const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);
void locale;

const order = env?.DB
  ? await env.DB.prepare("SELECT * FROM orders WHERE id = ?").bind(id).first<{
      id: string;
      customer_email: string;
      customer_name: string;
      customer_phone: string | null;
      shipping_address: string;
      locale: string;
      items: string;
      subtotal: number;
      currency: string;
      shipping_fee: number;
      total: number;
      status: string;
      payment_status: string;
      notes: string | null;
      tracking_number: string | null;
      created_at: number;
      updated_at: number;
    }>()
  : null;

const shippingAddress = order
  ? (JSON.parse(order.shipping_address) as Record<string, string>)
  : {};
const items = order
  ? (JSON.parse(order.items) as Array<{
      slug: string;
      qty: number;
      sku?: string;
    }>)
  : [];
---

<AdminLayout
  title={`${t("admin.orders_detail.title_prefix")} ${id}`}
  active="orders"
>
  {
    !order ? (
      <div class="bg-error/10 border border-error text-error rounded-card p-4">
        {t("admin.orders_detail.not_found")}
      </div>
    ) : (
      <div class="space-y-6">
        <div class="bg-bg-card border border-text-muted/20 rounded-card p-6">
          <h2 class="font-serif text-lg mb-3">
            {t("admin.orders_detail.sec_customer")}
          </h2>
          <dl class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm">
            <>
              <dt class="text-text-muted">
                {t("admin.orders_detail.field_name")}
              </dt>
              <dd>{order.customer_name}</dd>
            </>
            <>
              <dt class="text-text-muted">
                {t("admin.orders_detail.field_email")}
              </dt>
              <dd>
                <a
                  href={`mailto:${order.customer_email}`}
                  class="text-accent-700 underline"
                >
                  {order.customer_email}
                </a>
              </dd>
            </>
            <>
              <dt class="text-text-muted">
                {t("admin.orders_detail.field_phone")}
              </dt>
              <dd>{order.customer_phone ?? "—"}</dd>
            </>
            <>
              <dt class="text-text-muted">
                {t("admin.orders_detail.field_locale")}
              </dt>
              <dd>{order.locale}</dd>
            </>
          </dl>
        </div>

        <div class="bg-bg-card border border-text-muted/20 rounded-card p-6">
          <h2 class="font-serif text-lg mb-3">
            {t("admin.orders_detail.sec_shipping")}
          </h2>
          <div class="text-sm space-y-1">
            <div>{shippingAddress.address}</div>
            <div>
              {shippingAddress.city}, {shippingAddress.postal}
            </div>
            <div>{shippingAddress.country}</div>
          </div>
        </div>

        <div class="bg-bg-card border border-text-muted/20 rounded-card p-6">
          <h2 class="font-serif text-lg mb-3">
            {t("admin.orders_detail.sec_items", { n: items.length })}
          </h2>
          <table class="w-full text-sm">
            <thead class="text-text-muted">
              <tr>
                <>
                  <th class="text-left py-1">
                    {t("admin.orders_detail.col_slug")}
                  </th>
                  <th class="text-left py-1">
                    {t("admin.orders_detail.col_sku")}
                  </th>
                  <th class="text-right py-1">
                    {t("admin.orders_detail.col_qty")}
                  </th>
                </>
              </tr>
            </thead>
            <tbody>
              {items.map((i) => (
                <tr class="border-t border-text-muted/10">
                  <td class="py-1.5 font-mono">{i.slug}</td>
                  <td class="py-1.5 font-mono">{i.sku ?? "—"}</td>
                  <td class="py-1.5 text-right">{i.qty}</td>
                </tr>
              ))}
            </tbody>
            <tfoot>
              <tr class="border-t-2 border-text-muted/30 font-medium">
                <td colspan="2" class="py-2 text-right">
                  {t("admin.orders_detail.subtotal")}
                </td>
                <td class="py-2 text-right font-mono">
                  {order.subtotal} {order.currency}
                </td>
              </tr>
            </tfoot>
          </table>
        </div>

        <div class="bg-bg-card border border-text-muted/20 rounded-card p-6">
          <h2 class="font-serif text-lg mb-3">
            {t("admin.orders_detail.sec_status_update")}
          </h2>
          <form
            method="POST"
            action={`/api/admin/orders/${id}/status`}
            class="space-y-4"
          >
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div>
                <label class="block text-sm font-medium mb-1" for="status">
                  {t("admin.orders_detail.field_order_status")}
                </label>
                <select
                  id="status"
                  name="status"
                  class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
                >
                  {[
                    "pending",
                    "confirmed",
                    "shipped",
                    "delivered",
                    "cancelled",
                  ].map((s) => (
                    <option value={s} selected={order.status === s}>
                      {s}
                    </option>
                  ))}
                </select>
              </div>
              <div>
                <label
                  class="block text-sm font-medium mb-1"
                  for="payment_status"
                >
                  {t("admin.orders_detail.field_payment")}
                </label>
                <select
                  id="payment_status"
                  name="payment_status"
                  class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
                >
                  {["unpaid", "paid", "refunded"].map((s) => (
                    <option value={s} selected={order.payment_status === s}>
                      {s}
                    </option>
                  ))}
                </select>
              </div>
              <div>
                <label
                  class="block text-sm font-medium mb-1"
                  for="tracking_number"
                >
                  {t("admin.orders_detail.field_tracking")}
                </label>
                <input
                  id="tracking_number"
                  name="tracking_number"
                  value={order.tracking_number ?? ""}
                  class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base font-mono"
                />
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium mb-1" for="notes">
                {t("admin.orders_detail.field_notes")}
              </label>
              <textarea
                id="notes"
                name="notes"
                rows="3"
                class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
              >
                {order.notes ?? ""}
              </textarea>
            </div>
            <button
              type="submit"
              class="px-4 py-2 bg-forest-700 text-bg-base rounded-md hover:bg-forest-900"
            >
              {t("admin.orders_detail.btn_update")}
            </button>
          </form>
        </div>

        <div class="bg-bg-card border border-text-muted/20 rounded-card p-6 text-xs text-text-muted space-y-1">
          <div>
            {t("admin.orders_detail.meta_created")}{" "}
            {new Date(order.created_at * 1000).toISOString()}
          </div>
          <div>
            {t("admin.orders_detail.meta_updated")}{" "}
            {new Date(order.updated_at * 1000).toISOString()}
          </div>
          <div class="font-mono">
            {t("admin.orders_detail.meta_id")} {order.id}
          </div>
        </div>
      </div>
    )
  }
</AdminLayout>
