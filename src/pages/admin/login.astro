---
// /admin/login — local email + password login form
// 2026-10-01: replaces Cloudflare Access flow
import { getAdminFromContext } from "../../lib/auth";

const admin = await getAdminFromContext(Astro);
if (admin) {
  return Astro.redirect("/admin", 303);
}

const url = Astro.url;
const redirectTo = url.searchParams.get("redirect") ?? "/admin";
const error = url.searchParams.get("error");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login · cnamber-store</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body
    class="min-h-screen bg-bg-base font-sans text-text-primary flex items-center justify-center px-4"
  >
    <div
      class="max-w-md w-full bg-bg-card border border-text-muted/20 rounded-card p-8 shadow-soft"
    >
      <div class="text-center mb-6">
        <h1 class="font-serif text-2xl text-forest-800 mb-1">
          cnamber-store Admin
        </h1>
        <p class="text-xs uppercase tracking-wider text-text-muted">
          Local sign-in
        </p>
      </div>

      {
        error && (
          <div class="mb-4 p-3 border border-red-500/30 bg-red-50 text-red-700 text-sm rounded">
            {error === "invalid" && "Email or password incorrect."}
            {error === "empty" && "Email and password are required."}
            {error === "server" &&
              "Server misconfiguration. Contact site owner."}
          </div>
        )
      }

      <form method="POST" action="/api/admin/login" class="space-y-4">
        <input type="hidden" name="redirect" value={redirectTo} />
        <div>
          <label class="block text-sm font-medium mb-1" for="email">Email</label
          >
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="username"
            class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" for="password"
            >Password</label
          >
          <input
            id="password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
          />
        </div>
        <button
          type="submit"
          class="w-full px-4 py-2 bg-forest-700 text-bg-base rounded-md hover:bg-forest-900"
        >
          Sign in
        </button>
      </form>

      <p class="text-xs text-text-muted text-center mt-6">
        Authorized personnel only. All access is logged.
      </p>
    </div>
  </body>
</html>
