---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { env } from "cloudflare:workers";
import { createT, tEnum } from "../../../i18n/t";
import { defaultLocale, type Locale } from "../../../i18n/config";
import zhHansMessages from "../../../i18n/messages/zh-Hans.json";

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = zhHansMessages as Record<string, unknown>;
const t = createT(messages);
void locale;

const reviews = env?.DB
  ? await env.DB.prepare(
      "SELECT id, product_id, customer_name, rating, content, status, created_at FROM reviews ORDER BY created_at DESC LIMIT 100",
    ).all()
  : { results: [] as Array<Record<string, unknown>> };
---

<AdminLayout title={t("admin.reviews_list.title")} active="reviews">
  <p class="text-text-secondary mb-6">
    {t("admin.reviews_list.subtitle", { n: reviews.results.length })}
  </p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {
      reviews.results.length === 0 && (
        <div class="col-span-2 bg-bg-card border border-text-muted/20 rounded-card p-8 text-center text-text-muted">
          {t("admin.reviews_list.empty")}
        </div>
      )
    }
    {
      reviews.results.map((r) => (
        <article class="bg-bg-card border border-text-muted/20 rounded-card p-5">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-2">
              <span class="text-accent-700">
                {"★".repeat(r.rating as number)}
              </span>
              <span class="text-xs text-text-muted">
                {r.rating as number}/5
              </span>
            </div>
            <span
              class={`px-2 py-0.5 rounded text-xs ${
                r.status === "approved"
                  ? "bg-success/20 text-success"
                  : r.status === "rejected"
                    ? "bg-error/20 text-error"
                    : "bg-warning/20 text-warning"
              }`}
            >
              {tEnum(t, "status", r.status as string)}
            </span>
          </div>
          <h3 class="font-medium mb-2">{r.customer_name as string}</h3>
          <p class="text-sm text-text-secondary leading-relaxed">
            {r.content as string}
          </p>
          <div class="text-xs text-text-muted mt-3 font-mono">
            {r.id as string} ·{" "}
            {new Date((r.created_at as number) * 1000)
              .toISOString()
              .slice(0, 10)}
          </div>
        </article>
      ))
    }
  </div>
</AdminLayout>
