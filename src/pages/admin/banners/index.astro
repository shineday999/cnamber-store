---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { createT } from "../../../i18n/t";
import { defaultLocale, type Locale } from "../../../i18n/config";
import zhHansMessages from "../../../i18n/messages/zh-Hans.json";

const env = Astro.locals.runtime?.env;
const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = zhHansMessages as Record<string, unknown>;
const t = createT(messages);
void locale;

const banners = env?.DB
  ? await env.DB.prepare(
      "SELECT id, image_url, alt_text, sort_order, active, created_at, updated_at FROM hero_banners ORDER BY sort_order ASC, created_at DESC",
    ).all<{
      id: string;
      image_url: string;
      alt_text: string | null;
      sort_order: number;
      active: number;
      created_at: number;
      updated_at: number;
    }>()
  : {
      results: [] as Array<{
        id: string;
        image_url: string;
        alt_text: string | null;
        sort_order: number;
        active: number;
        created_at: number;
        updated_at: number;
      }>,
    };
---

<AdminLayout title={t("admin.banners.title")} active="banners">
  <p class="text-text-secondary mb-6">
    {t("admin.banners.subtitle", { n: banners.results.length })}
  </p>

  <div class="bg-bg-card border border-text-muted/20 rounded-card p-6 mb-6">
    <h2 class="font-serif text-lg mb-3">{t("admin.banners.upload")}</h2>
    <p class="text-sm text-warning mb-2">
      <strong>{t("admin.banners.dimension_label")}:</strong> 1920×1080
    </p>
    <p class="text-xs text-text-muted mb-4">
      {t("admin.banners.hint_dimension")}
    </p>
    <form
      method="POST"
      action="/api/admin/banners"
      enctype="multipart/form-data"
      class="space-y-3 max-w-2xl"
    >
      <div>
        <label class="block text-sm font-medium mb-1" for="image"
          >{t("admin.banners.upload_image")}</label
        >
        <input
          id="image"
          name="image"
          type="file"
          accept="image/jpeg,image/png,image/webp,image/gif"
          required
          class="w-full text-sm file:mr-3 file:py-2 file:px-4 file:border-0 file:bg-forest-700 file:text-bg-base file:rounded file:cursor-pointer"
        />
      </div>
      <div class="grid grid-cols-3 gap-3">
        <div class="col-span-2">
          <label class="block text-sm font-medium mb-1" for="alt_text"
            >{t("admin.banners.alt_text")}</label
          >
          <input
            id="alt_text"
            name="alt_text"
            type="text"
            class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
          />
          <p class="text-xs text-text-muted mt-1">
            {t("admin.banners.alt_hint")}
          </p>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" for="sort_order"
            >{t("admin.banners.sort_order")}</label
          >
          <input
            id="sort_order"
            name="sort_order"
            type="number"
            value="0"
            class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
          />
          <p class="text-xs text-text-muted mt-1">
            {t("admin.banners.sort_hint")}
          </p>
        </div>
      </div>
      <label class="inline-flex items-center gap-2 text-sm">
        <input type="checkbox" name="active" value="1" checked />
        <span>{t("admin.banners.active")}</span>
        <span class="text-text-muted text-xs"
          >({t("admin.banners.active_hint")})</span
        >
      </label>
      <div>
        <button
          type="submit"
          class="px-4 py-2 bg-forest-700 text-bg-base rounded-md hover:bg-forest-900"
        >
          {t("admin.banners.upload")}
        </button>
      </div>
    </form>
  </div>

  <div
    class="bg-bg-card border border-text-muted/20 rounded-card overflow-hidden"
  >
    <table class="w-full text-sm">
      <thead class="bg-forest-100 text-text-primary">
        <tr>
          <th class="text-left px-4 py-3 font-medium"
            >{t("admin.banners.preview")}</th
          >
          <th class="text-left px-4 py-3 font-medium"
            >{t("admin.banners.alt_text")}</th
          >
          <th class="text-left px-4 py-3 font-medium"
            >{t("admin.banners.sort_order")}</th
          >
          <th class="text-left px-4 py-3 font-medium"
            >{t("admin.banners.active")}</th
          >
          <th class="text-right px-4 py-3 font-medium">操作</th>
        </tr>
      </thead>
      <tbody>
        {
          banners.results.length === 0 && (
            <tr>
              <td colspan="5" class="px-4 py-8 text-center text-text-muted">
                {t("admin.banners.empty")}
              </td>
            </tr>
          )
        }
        {
          banners.results.map((b) => (
            <tr class="border-t border-text-muted/10 hover:bg-bg-base">
              <td class="px-4 py-3">
                <img
                  src={b.image_url}
                  alt={b.alt_text ?? ""}
                  class="w-32 h-18 object-cover rounded border border-text-muted/20"
                />
              </td>
              <td class="px-4 py-3 font-medium">{b.alt_text ?? "—"}</td>
              <td class="px-4 py-3 font-mono text-xs">{b.sort_order}</td>
              <td class="px-4 py-3">
                <span
                  class={`px-2 py-0.5 rounded text-xs font-medium ${b.active === 1 ? "bg-success/20 text-success" : "bg-text-muted/20 text-text-secondary"}`}
                >
                  {b.active === 1
                    ? t("admin.banners.active")
                    : t("admin.banners.deactivate")}
                </span>
              </td>
              <td class="px-4 py-3 text-right whitespace-nowrap">
                <form
                  method="POST"
                  action={`/api/admin/banners/${b.id}`}
                  class="inline"
                >
                  <input type="hidden" name="_method" value="PATCH" />
                  <input
                    type="hidden"
                    name="alt_text"
                    value={b.alt_text ?? ""}
                  />
                  <input type="hidden" name="sort_order" value={b.sort_order} />
                  <input
                    type="hidden"
                    name="active"
                    value={b.active === 1 ? "0" : "1"}
                  />
                  <button type="submit" class="text-accent-700 hover:underline">
                    {b.active === 1
                      ? t("admin.banners.deactivate")
                      : t("admin.banners.activate")}
                  </button>
                </form>
                <span class="text-text-muted/50 mx-1" aria-hidden="true">
                  ·
                </span>
                <button
                  type="button"
                  class="text-error hover:underline"
                  data-banner-id={b.id}
                >
                  {t("admin.banners.delete")}
                </button>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</AdminLayout>

<script is:inline>
  (function () {
    var confirmText = "确定删除该横幅？图片会从 R2 一并移除";
    document.querySelectorAll("[data-banner-id]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var id = btn.getAttribute("data-banner-id");
        if (!id) return;
        if (!window.confirm(confirmText)) return;
        var f = document.createElement("form");
        f.method = "POST";
        f.action = "/api/admin/banners/" + id;
        var m = document.createElement("input");
        m.name = "_method";
        m.value = "DELETE";
        f.appendChild(m);
        document.body.appendChild(f);
        f.submit();
      });
    });
  })();
</script>
