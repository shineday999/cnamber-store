---
// src/pages/404.astro — on-brand 404 page (forest, contemplative).
// Returns proper HTTP 404 status via Astro convention; replaces the default
// 302→/ behavior of Cloudflare Pages when no 404.astro exists.
import Layout from "@layouts/Layout.astro";
import RevealOnScroll from "@components/RevealOnScroll.astro";
import { createT } from "../i18n/t";

const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);

const title = t("404.title");
const subtitle = t("404.subtitle");
const ctaPrimary = t("404.cta_primary");
const ctaSecondary = t("404.cta_secondary");
const kicker = t("404.kicker");

const pageTitle = t("common.site_name") + " — " + title;
const pageDescription = subtitle;
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="min-h-[70vh] flex items-center justify-center px-6 py-24">
    <RevealOnScroll class="w-full max-w-2xl">
      <div class="text-center">
        <p class="text-xs uppercase tracking-[0.4em] text-text-muted mb-8">
          {kicker}
        </p>
        <h1
          class="font-serif text-5xl md:text-7xl text-forest-800 leading-[1.1] mb-6"
        >
          {title}
        </h1>
        <p
          class="text-lg md:text-xl text-text-secondary mb-12 max-w-lg mx-auto leading-relaxed"
        >
          {subtitle}
        </p>
        <div
          class="flex flex-col sm:flex-row items-center justify-center gap-4"
        >
          <a
            href="/"
            class="inline-block px-8 py-3 bg-forest-800 text-bg-base font-sans text-sm tracking-wider hover:bg-forest-900 transition-colors duration-300"
          >
            {ctaPrimary}
          </a>
          <a
            href="/products"
            class="inline-block px-8 py-3 border border-forest-800 text-forest-800 font-sans text-sm tracking-wider hover:bg-forest-800 hover:text-bg-base transition-colors duration-300"
          >
            {ctaSecondary}
          </a>
        </div>
      </div>
    </RevealOnScroll>
  </main>
</Layout>
